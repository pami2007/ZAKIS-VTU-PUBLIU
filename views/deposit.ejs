<!DOCTYPE html>

<html lang="en">

<head>
<link rel="icon" type="image/x-icon" href="/images/zaki_logo.png">
<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Fund Wallet | Zaki Sub</title>
<script src="/js/publicTheme.js"></script>

<style>

    /* =====================================================
       DEPOSIT PAGE
       Works with:
       DARK  = Brown + Gold
       LIGHT = Emerald + Navy + Gold
    ===================================================== */


    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
    }


    :root {

        --bg: #100909;

        --surface: #1B1111;

        --surface-2: #241616;

        --brand: #250D0D;

        --brand-light: #3A1818;

        --accent: #F5C451;

        --accent-dark: #D99A18;

        --text: #FFFFFF;

        --muted: #B9AFAF;

        --border: rgba(255,255,255,.09);

        --input-bg: rgba(255,255,255,.06);

        --shadow: 0 15px 40px rgba(0,0,0,.35);

        --notice-bg: rgba(245,196,81,.09);

        --notice-border: rgba(245,196,81,.25);

        --notice-text: #F5C451;
    }


    /* =====================================================
       LIGHT MODE
    ===================================================== */

    [data-theme="light"] {

        --bg: #F4F8F6;

        --surface: #FFFFFF;

        --surface-2: #EFF7F5;

        --brand: #0B1F33;

        --brand-light: #163B5C;

        --accent: #0F766E;

        --accent-dark: #0B5F59;

        --text: #10202F;

        --muted: #64748B;

        --border: rgba(11,31,51,.10);

        --input-bg: #F5F8FA;

        --shadow: 0 15px 40px rgba(11,31,51,.10);

        --notice-bg: rgba(217,154,24,.09);

        --notice-border: rgba(217,154,24,.25);

        --notice-text: #A66E00;
    }


    /* =====================================================
       BODY
    ===================================================== */

    body {

        min-height: 100vh;

        background:
            radial-gradient(
                circle at top left,
                rgba(245,196,81,.07),
                transparent 35%
            ),

            radial-gradient(
                circle at bottom right,
                rgba(15,118,110,.07),
                transparent 35%
            ),

            var(--bg);

        color: var(--text);

        padding: 25px;

        transition:
            background .3s ease,
            color .3s ease;
    }


    /* =====================================================
       PAGE
    ===================================================== */

    .deposit-page {

        width: 100%;

        max-width: 600px;

        margin: 40px auto;
    }


    /* =====================================================
       TOP BAR
    ===================================================== */

    .top-bar {

        display: flex;

        align-items: center;

        justify-content: space-between;

        margin-bottom: 20px;
    }


    .back-link {

        text-decoration: none;

        color: var(--muted);

        font-size: 14px;

        display: inline-flex;

        align-items: center;

        gap: 6px;

        transition: .3s;
    }


    .back-link:hover {

        color: var(--accent);
    }


    .page-label {

        font-size: 13px;

        color: var(--accent);

        font-weight: bold;

        letter-spacing: .5px;
    }


    /* =====================================================
       MAIN CARD
    ===================================================== */

    .deposit-card {

        background:
            linear-gradient(
                145deg,
                var(--surface),
                var(--surface-2)
            );

        border: 1px solid var(--border);

        border-radius: 24px;

        padding: 30px;

        box-shadow: var(--shadow);

        position: relative;

        overflow: hidden;
    }


    /* Decorative circle */

    .deposit-card::before {

        content: "";

        position: absolute;

        width: 180px;

        height: 180px;

        border-radius: 50%;

        background: rgba(245,196,81,.06);

        right: -80px;

        top: -80px;
    }


    /* =====================================================
       HEADER
    ===================================================== */

    .deposit-header {

        position: relative;

        z-index: 2;

        margin-bottom: 25px;
    }


    .wallet-icon {

        width: 58px;

        height: 58px;

        border-radius: 17px;

        display: flex;

        align-items: center;

        justify-content: center;

        background:
            linear-gradient(
                135deg,
                var(--accent),
                var(--accent-dark)
            );

        color: #111;

        font-size: 25px;

        margin-bottom: 16px;

        box-shadow:
            0 8px 20px rgba(245,196,81,.18);
    }


    .deposit-header h1 {

        font-size: 28px;

        margin-bottom: 8px;

        color: var(--text);
    }


    .deposit-header p {

        color: var(--muted);

        font-size: 14px;

        line-height: 1.6;
    }


    /* =====================================================
       ALERT / CHARGE NOTICE
    ===================================================== */

    .charge-notice {

        position: relative;

        z-index: 2;

        display: flex;

        align-items: flex-start;

        gap: 12px;

        padding: 15px;

        margin-bottom: 24px;

        border-radius: 15px;

        background: var(--notice-bg);

        border: 1px solid var(--notice-border);
    }


    .notice-icon {

        width: 32px;

        height: 32px;

        min-width: 32px;

        border-radius: 10px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: rgba(245,196,81,.15);

        color: var(--notice-text);

        font-weight: bold;

        font-size: 15px;
    }


    .notice-content strong {

        display: block;

        color: var(--notice-text);

        font-size: 13px;

        margin-bottom: 4px;
    }


    .notice-content p {

        color: var(--muted);

        font-size: 12px;

        line-height: 1.6;
    }


    /* =====================================================
       FORM
    ===================================================== */

    .deposit-form {

        position: relative;

        z-index: 2;
    }


    .amount-label {

        display: block;

        color: var(--text);

        font-size: 14px;

        font-weight: bold;

        margin-bottom: 8px;
    }


    .amount-wrapper {

        position: relative;

        margin-bottom: 15px;
    }


    .currency {

        position: absolute;

        left: 16px;

        top: 50%;

        transform: translateY(-50%);

        color: var(--accent);

        font-size: 17px;

        font-weight: bold;

        z-index: 2;
    }


    .amount-input {

        width: 100%;

        height: 58px;

        border-radius: 14px;

        border: 1px solid var(--border);

        background: var(--input-bg);

        color: var(--text);

        outline: none;

        padding: 0 18px 0 42px;

        font-size: 20px;

        font-weight: bold;

        transition: .3s;
    }


    .amount-input::placeholder {

        color: var(--muted);

        font-weight: normal;
    }


    .amount-input:focus {

        border-color: var(--accent);

        box-shadow:
            0 0 0 3px
            rgba(15,118,110,.10);
    }


    /* Remove number arrows */

    .amount-input::-webkit-outer-spin-button,
    .amount-input::-webkit-inner-spin-button {

        -webkit-appearance: none;

        margin: 0;
    }



    /* =====================================================
       QUICK AMOUNTS
    ===================================================== */

    .quick-amounts {

        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        gap: 8px;

        margin-bottom: 22px;
    }


    .quick-amount {

        border: 1px solid var(--border);

        background: var(--input-bg);

        color: var(--muted);

        padding: 9px 5px;

        border-radius: 9px;

        cursor: pointer;

        font-size: 12px;

        transition: .3s;
    }


    .quick-amount:hover {

        color: var(--accent);

        border-color: var(--accent);

        transform: translateY(-2px);
    }


    /* =====================================================
       SUBMIT BUTTON
    ===================================================== */

    .fund-button {

        width: 100%;

        height: 54px;

        border: none;

        border-radius: 14px;

        cursor: pointer;

        background:
            linear-gradient(
                135deg,
                var(--accent),
                var(--accent-dark)
            );

        color: #111;

        font-size: 15px;

        font-weight: bold;

        box-shadow:
            0 10px 25px
            rgba(245,196,81,.15);

        transition: .3s;
    }


    .fund-button:hover {

        transform: translateY(-2px);

        box-shadow:
            0 13px 30px
            rgba(245,196,81,.22);
    }


    .fund-button:active {

        transform: translateY(0);
    }


    /* =====================================================
       BOTTOM INFORMATION
    ===================================================== */

    .deposit-info {

        margin-top: 22px;

        padding-top: 18px;

        border-top: 1px solid var(--border);

        display: flex;

        justify-content: space-between;

        gap: 15px;
    }


    .info-item {

        display: flex;

        align-items: center;

        gap: 7px;

        color: var(--muted);

        font-size: 11px;
    }


    .info-dot {

        width: 7px;

        height: 7px;

        border-radius: 50%;

        background: var(--accent);
    }


    /* =====================================================
       ALERTS
    ===================================================== */

    .alerts {

        margin-bottom: 15px;
    }


    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 600px) {

        body {

            padding: 15px;
        }


        .deposit-page {

            margin: 20px auto;
        }


        .deposit-card {

            padding: 23px 18px;

            border-radius: 20px;
        }


        .deposit-header h1 {

            font-size: 24px;
        }


        .quick-amounts {

            grid-template-columns:
                repeat(2, 1fr);
        }


        .deposit-info {

            flex-direction: column;

            gap: 10px;
        }
    }


    /* =====================================================
       VERY SMALL PHONES
    ===================================================== */

    @media (max-width: 360px) {

        .deposit-card {

            padding: 20px 15px;
        }


        .amount-input {

            height: 54px;

            font-size: 18px;
        }


        .fund-button {

            height: 50px;
        }
    }

</style>

<link rel=" stylesheet"  href="/css/historyDetail.css">
</head>

<body>

<main class="deposit-page">


    <!-- ALERTS -->

    <div class="alerts">

        <%- include('partials/alerts') %>

    </div>


    <!-- TOP -->

    <div class="top-bar">

        <a
            href="/"
            class="back-link"
        >
            ← Home
        </a>

        <span class="page-label">
            WALLET
        </span>

    </div>


    <!-- DEPOSIT CARD -->

    <section class="deposit-card">


        <!-- HEADER -->

        <div class="deposit-header">

            <div class="wallet-icon">
                ₦
            </div>

            <h1>
                Fund Your Wallet
            </h1>

            <p>
                Add money to your Zaki Sub wallet
                and start using our services instantly.
            </p>

        </div>


        <!-- CHARGE NOTICE -->

        <div class="charge-notice">

            <div class="notice-icon">
                !
            </div>

            <div class="notice-content">

                <strong>
                    Please note: charges may apply
                </strong>

                <p>
                    Your payment provider or the service
                    used to process your wallet funding may
                    apply a transaction or processing fee.
                    Please review the final amount before
                    completing your payment.
                </p>

            </div>

        </div>


        <!-- FORM -->

        <form
            action="/deposit"
            method="POST"
            class="deposit-form"
        >

            <label
                for="amount"
                class="amount-label"
            >
                Amount to Fund
            </label>


            <div class="amount-wrapper">

                <span class="currency">
                    ₦
                </span>

                <input
                    id="amount"
                    type="number"
                    name="amount"
                    class="amount-input"
                    placeholder="Enter amount"
                    value="1000"
                    min="1"
                    
                >

            </div>


            <!-- QUICK AMOUNTS -->

            <div class="quick-amounts">

                <button
                    type="button"
                    class="quick-amount"
                    onclick="setAmount(1000)"
                >
                    ₦1,000
                </button>

                <button
                    type="button"
                    class="quick-amount"
                    onclick="setAmount(2000)"
                >
                    ₦2,000
                </button>

                <button
                    type="button"
                    class="quick-amount"
                    onclick="setAmount(5000)"
                >
                    ₦5,000
                </button>

                <button
                    type="button"
                    class="quick-amount"
                    onclick="setAmount(10000)"
                >
                    ₦10,000
                </button>

            </div>


            <!-- SUBMIT -->

            <button
                type="submit"
                class="fund-button"
            >
                Fund Wallet →
            </button>

        </form>


        <!-- INFORMATION -->

        <div class="deposit-info">

            <div class="info-item">

                <span class="info-dot"></span>

                Secure payment

            </div>


            <div class="info-item">

                <span class="info-dot"></span>

                Wallet credited after confirmation

            </div>

        </div>


    </section>

</main>


<!-- QUICK AMOUNT SCRIPT -->

<script>

    function setAmount(amount) {

        const input =
            document.getElementById("amount");

        input.value = amount;

        input.focus();

    }

</script>
<script src="/js/pub.js"></script>
</body>

</html>
