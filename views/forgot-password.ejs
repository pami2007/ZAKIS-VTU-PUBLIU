<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Forgot Password | Zaki Sub</title>


    <style>

        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =====================================================
           DARK MODE
           Brown + Gold
        ===================================================== */

        :root {

            --bg: #250D0D;

            --bg-secondary: #170707;

            --card: rgba(255,255,255,.08);

            --card-border: rgba(255,255,255,.15);

            --text: #ffffff;

            --muted: #d6caca;

            --input-bg: rgba(255,255,255,.08);

            --input-border: rgba(255,255,255,.20);

            --accent: #F5C451;

            --accent-dark: #D99A18;

            --link: #F5C451;

            --shadow:
                0 20px 45px rgba(0,0,0,.40);
        }


        /* =====================================================
           LIGHT MODE
           Emerald + Navy + Gold
        ===================================================== */

        [data-theme="light"] {

            --bg: #F4F8F6;

            --bg-secondary: #E8F1EE;

            --card: rgba(255,255,255,.82);

            --card-border: rgba(11,31,51,.12);

            --text: #10202F;

            --muted: #64748B;

            --input-bg: rgba(255,255,255,.75);

            --input-border: rgba(11,31,51,.14);

            --accent: #0F766E;

            --accent-dark: #0B5F59;

            --link: #0F766E;

            --shadow:
                0 20px 45px rgba(11,31,51,.10);
        }


        /* =====================================================
           BODY
        ===================================================== */

        body {

            min-height: 100vh;

            display: flex;

            justify-content: center;

            align-items: center;

            padding: 20px;

            background:

                radial-gradient(
                    circle at top left,
                    rgba(245,196,81,.10),
                    transparent 35%
                ),

                radial-gradient(
                    circle at bottom right,
                    rgba(15,118,110,.10),
                    transparent 35%
                ),

                var(--bg);

            color: var(--text);

            transition:
                background .3s ease,
                color .3s ease;
        }


        /* =====================================================
           THEME BUTTON
        ===================================================== */

        .theme-toggle {

            position: fixed;

            top: 20px;

            right: 20px;

            width: 44px;

            height: 44px;

            border-radius: 50%;

            border: 1px solid var(--card-border);

            background: var(--card);

            color: var(--text);

            backdrop-filter: blur(12px);

            -webkit-backdrop-filter: blur(12px);

            cursor: pointer;

            font-size: 18px;

            display: flex;

            align-items: center;

            justify-content: center;

            transition: .3s;

            z-index: 10;
        }


        .theme-toggle:hover {

            background: var(--accent);

            color: #111;

            transform: scale(1.08);
        }


        /* =====================================================
           CONTAINER
        ===================================================== */

        .container {

            width: 100%;

            max-width: 420px;
        }


        /* =====================================================
           LOGO
        ===================================================== */

        .logo {

            text-align: center;

            margin-bottom: 25px;
        }


        .logo h1 {

            color: var(--text);

            font-size: 32px;

            margin-bottom: 8px;

            font-weight: 800;

            letter-spacing: .5px;
        }


        .logo h1 span {

            color: var(--accent);
        }


        .logo p {

            color: var(--muted);

            font-size: 15px;

            line-height: 1.5;
        }


        /* =====================================================
           CARD
        ===================================================== */

        .card {

            background: var(--card);

            backdrop-filter: blur(15px);

            -webkit-backdrop-filter: blur(15px);

            border: 1px solid var(--card-border);

            border-radius: 20px;

            padding: 30px;

            box-shadow: var(--shadow);

            transition:
                background .3s ease,
                border-color .3s ease,
                box-shadow .3s ease;
        }


        /* =====================================================
           ICON
        ===================================================== */

        .icon {

            width: 64px;

            height: 64px;

            margin: 0 auto 20px;

            border-radius: 18px;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: #fff;

            font-size: 28px;

            box-shadow:
                0 10px 25px
                rgba(15,118,110,.15);
        }


        /* =====================================================
           TITLE
        ===================================================== */

        .card h2 {

            text-align: center;

            color: var(--text);

            font-size: 23px;

            margin-bottom: 10px;
        }


        .description {

            text-align: center;

            color: var(--muted);

            font-size: 14px;

            line-height: 1.6;

            margin-bottom: 25px;
        }


        /* =====================================================
           LABEL
        ===================================================== */

        label {

            display: block;

            color: var(--text);

            font-weight: bold;

            font-size: 14px;

            margin-bottom: 7px;
        }


        /* =====================================================
           INPUT
        ===================================================== */

        input[type="email"] {

            width: 100%;

            height: 48px;

            padding: 0 15px;

            border-radius: 10px;

            border: 1px solid var(--input-border);

            background: var(--input-bg);

            color: var(--text);

            outline: none;

            font-size: 15px;

            transition: .3s;
        }


        input[type="email"]::placeholder {

            color: var(--muted);

            opacity: .8;
        }


        input[type="email"]:focus {

            border-color: var(--accent);

            box-shadow:
                0 0 0 3px
                rgba(15,118,110,.10);

            background: var(--input-bg);
        }


        /* =====================================================
           BUTTON
        ===================================================== */

        .btn {

            width: 100%;

            height: 48px;

            margin-top: 22px;

            border: none;

            border-radius: 30px;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: #fff;

            font-size: 15px;

            font-weight: bold;

            cursor: pointer;

            transition: .3s;

            box-shadow:
                0 8px 20px
                rgba(15,118,110,.15);
        }


        .btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 12px 28px
                rgba(15,118,110,.22);
        }


        .btn:active {

            transform: translateY(0);
        }


        /* =====================================================
           BACK TO LOGIN
        ===================================================== */

        .back-login {

            text-align: center;

            margin-top: 20px;
        }


        .back-login a {

            color: var(--link);

            text-decoration: none;

            font-size: 14px;

            font-weight: bold;

            transition: .3s;
        }


        .back-login a:hover {

            text-decoration: underline;
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .footer {

            text-align: center;

            margin-top: 25px;

            color: var(--muted);

            font-size: 13px;
        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 600px) {

            body {

                padding: 15px;
            }


            .theme-toggle {

                top: 15px;

                right: 15px;

                width: 40px;

                height: 40px;
            }


            .logo h1 {

                font-size: 28px;
            }


            .card {

                padding: 25px 20px;

                border-radius: 18px;
            }


            .card h2 {

                font-size: 21px;
            }
        }


        /* =====================================================
           VERY SMALL PHONE
        ===================================================== */

        @media (max-width: 380px) {

            .card {

                padding: 22px 17px;
            }


            .icon {

                width: 58px;

                height: 58px;

                font-size: 24px;
            }


            input[type="email"] {

                height: 45px;
            }


            .btn {

                height: 46px;
            }
        }

    </style>

</head>


<body>
    <%- include('partials/alerts') %>



    <!-- THEME BUTTON -->

    <button
        type="button"
        class="theme-toggle"
        id="themeToggle"
        aria-label="Change theme"
    >
        🌙
    </button>


    <div class="container">


        <!-- LOGO -->

        <div class="logo">

            <h1>
                ZAKI <span>SUB</span>
            </h1>

            <p>
                Recover your account securely
            </p>

        </div>


        <!-- CARD -->

        <div class="card">


            <!-- ICON -->

            <div class="icon">
                🔐
            </div>


            <h2>
                Forgot Password?
            </h2>


            <p class="description">
                Enter the email address linked to your
                account and we'll help you reset your password.
            </p>


            <!-- FORM -->

            <form
                action="/forgot-password"
                method="POST"
            >

                <label for="email">
                    Email Address
                </label>


                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    autocomplete="email"
                    required
                >


                <button
                    type="submit"
                    class="btn"
                >
                    Reset Password
                </button>

            </form>


            <!-- BACK TO LOGIN -->

            <div class="back-login">

                <a href="/login">
                    ← Back to Login
                </a>

            </div>


        </div>


        <!-- FOOTER -->

        <div class="footer">

            © <%= new Date().getFullYear() %> Zaki Sub.
            All rights reserved.

        </div>


    </div>


    <!-- THEME SCRIPT -->

    <script>

        const themeToggle =
            document.getElementById("themeToggle");


        function applyTheme(theme) {

            document.documentElement.setAttribute(
                "data-theme",
                theme
            );


            if (theme === "light") {

                themeToggle.textContent = "☀️";

            } else {

                themeToggle.textContent = "🌙";

            }
        }


        /* Load saved theme */

        const savedTheme =
            localStorage.getItem("zaki-theme") || "dark";


        applyTheme(savedTheme);


        /* Change theme */

        themeToggle.addEventListener(
            "click",
            function () {

                const currentTheme =
                    document.documentElement.getAttribute(
                        "data-theme"
                    ) || "dark";


                const newTheme =
                    currentTheme === "dark"
                        ? "light"
                        : "dark";


                localStorage.setItem(
                    "zaki-theme",
                    newTheme
                );


                applyTheme(newTheme);

            }
        );

    </script>


</body>
</html>