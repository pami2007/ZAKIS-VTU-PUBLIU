                </div>


                <div class="why-item">

                    <div class="why-number">
                        04
                    </div>

                    <div>

                        <h3>
                            Built for Nigeria
                        </h3>

                        <p>

                            Zaki Sub is focused on solving
                            everyday digital payment problems
                            faced by Nigerians.

                        </p>

                    </div>

                </div>


            </div>

