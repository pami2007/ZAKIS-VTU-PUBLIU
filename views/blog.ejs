    <!-- =====================================================
         ZAKI CHATBOT
    ===================================================== -->

    <section
        class="chatbot-section"
        id="chatbot"
    >

        <div class="container">


            <div class="chatbot-card">


                <div>

                    <div class="chatbot-label">

                        Coming to Zaki

                    </div>


                    <h2 class="">

                        Meet Zaki Chatbot.

                    </h2>


                    <p>

                        We're working toward bringing Zaki
                        closer to you through WhatsApp.

                        Imagine being able to interact with
                        Zaki, check your services and perform
                        supported transactions without
                        leaving WhatsApp.

                    </p>


                    <a
                        href="/register"
                        class="primary-btn"
                    >
                        Join Zaki Sub
                    </a>

                </div>



                <div class="chat-preview">


                    <div class="chat-header">

                        Zaki WhatsApp

                    </div>


                    <div class="chat-message user">

                        Hi Zaki, I need data.

                    </div>


                    <div class="chat-message bot">

                        Hello 👋

                        What network would you like
                        to purchase data for?

                    </div>


                    <div class="chat-message user">

                        MTN

                    </div>


                    <div class="chat-message bot">

                        Great. Choose your preferred
                        data plan and let's continue.

                    </div>


                </div>


            </div>

        </div>

    </section>



