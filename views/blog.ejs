                        </div>


                        <div class="phone-service">

                            ↔

                            <strong>
                                History
                            </strong>

                        </div>


                    </div>


                </div>


                <div class="floating-card two">

                    Affordable bills

                    <strong>
                        ₦ Save More
                    </strong>

                </div>


            </div>


        </div>

    </section>



