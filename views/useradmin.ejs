<!--
=========================================================
ZAKI SUB ADMIN - USER DASHBOARD
PURE HTML
=========================================================
-->

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
<link rel="icon" type="image/x-icon" href="/images/zaki_logo.png">
    <title>User Management - Zaki Sub</title>


    <!-- YOUR SIDEBAR CSS -->

    


    <style>

        /* =================================================
           USER DASHBOARD
        ================================================= */

        .users-page {

            width: 100%;

            max-width: 1500px;

            margin: auto;
        }


        /* =================================================
           PAGE HEADER
        ================================================= */

        .users-header {

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 20px;

            margin-bottom: 25px;
        }


        .users-title h1 {

            font-size: 28px;

            color: var(--admin-text);

            margin-bottom: 6px;
        }


        .users-title p {

            color: var(--admin-muted);

            font-size: 14px;
        }


        .add-user-btn {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            padding: 11px 18px;

            border-radius: 10px;

            background:
                linear-gradient(
                    135deg,
                    var(--admin-accent),
                    var(--admin-accent-dark)
                );

            color: #fff;

            text-decoration: none;

            font-size: 14px;

            font-weight: bold;

            border: none;

            transition: .25s ease;
        }


        .add-user-btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 8px 20px
                rgba(15,118,110,.20);
        }


        /* =================================================
           STATISTICS
        ================================================= */

        .user-stats {

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 16px;

            margin-bottom: 22px;
        }


        .user-stat-card {

            background: var(--admin-sidebar);

            border: 1px solid var(--admin-border);

            border-radius: 16px;

            padding: 18px;

            display: flex;

            align-items: center;

            gap: 14px;

            box-shadow:
                0 8px 25px
                rgba(0,0,0,.08);

            transition: .3s ease;
        }


        .user-stat-card:hover {

            transform: translateY(-3px);

            border-color:
                rgba(245,196,81,.25);
        }


        .user-stat-icon {

            width: 48px;

            height: 48px;

            min-width: 48px;

            border-radius: 13px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 19px;

            font-weight: bold;

            background:
                rgba(15,118,110,.10);

            color: var(--admin-accent);
        }


        .user-stat-info {

            min-width: 0;
        }


        .user-stat-info span {

            display: block;

            color: var(--admin-muted);

            font-size: 12px;

            margin-bottom: 5px;
        }


        .user-stat-info strong {

            display: block;

            color: var(--admin-text);

            font-size: 23px;
        }


        /* =================================================
           SEARCH / FILTER
        ================================================= */

        .users-toolbar {

            background: var(--admin-sidebar);

            border: 1px solid var(--admin-border);

            border-radius: 16px;

            padding: 15px;

            display: flex;

            align-items: center;

            gap: 12px;

            margin-bottom: 15px;
        }


        .user-search {

            flex: 1;

            position: relative;
        }


        .user-search input {

            width: 100%;

            height: 44px;

            padding:
                0 15px;

            border-radius: 10px;

            border: 1px solid var(--admin-border);

            background: var(--admin-bg);

            color: var(--admin-text);

            outline: none;

            font-size: 14px;

            transition: .25s ease;
        }


        .user-search input::placeholder {

            color: var(--admin-muted);
        }


        .user-search input:focus {

            border-color:
                var(--admin-accent);

            box-shadow:
                0 0 0 3px
                rgba(15,118,110,.08);
        }


        .user-filter {

            height: 44px;

            min-width: 150px;

            padding: 0 12px;

            border-radius: 10px;

            border: 1px solid var(--admin-border);

            background: var(--admin-bg);

            color: var(--admin-text);

            outline: none;

            cursor: pointer;
        }


        /* =================================================
           USERS TABLE CARD
        ================================================= */

        .users-table-card {

            background: var(--admin-sidebar);

            border: 1px solid var(--admin-border);

            border-radius: 16px;

            overflow: hidden;

            box-shadow:
                0 8px 25px
                rgba(0,0,0,.08);
        }


        .users-table-header {

            display: flex;

            justify-content: space-between;

            align-items: center;

            padding: 18px;

            border-bottom:
                1px solid var(--admin-border);
        }


        .users-table-header h2 {

            color: var(--admin-text);

            font-size: 17px;
        }


        .users-count {

            color: var(--admin-muted);

            font-size: 12px;
        }


        /* =================================================
           TABLE WRAPPER
        ================================================= */

        .users-table-wrapper {

            width: 100%;

            overflow-x: auto;
        }


        .users-table {

            width: 100%;

            min-width: 850px;

            border-collapse: collapse;
        }


        .users-table th {

            text-align: left;

            padding: 13px 15px;

            color: var(--admin-muted);

            font-size: 11px;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: .5px;

            background:
                var(--admin-sidebar-2);

            border-bottom:
                1px solid var(--admin-border);
        }


        .users-table td {

            padding: 14px 15px;

            color: var(--admin-text);

            font-size: 13px;

            border-bottom:
                1px solid var(--admin-border);

            white-space: nowrap;
        }


        .users-table tbody tr {

            transition: .25s ease;
        }


        .users-table tbody tr:hover {

            background:
                var(--admin-hover);
        }


        .users-table tbody tr:last-child td {

            border-bottom: none;
        }


        /* =================================================
           USER PROFILE
        ================================================= */

        .user-profile {

            display: flex;

            align-items: center;

            gap: 11px;
        }


        .user-avatar {

            width: 40px;

            height: 40px;

            min-width: 40px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    var(--admin-accent),
                    var(--admin-accent-dark)
                );

            color: #fff;

            font-weight: bold;

            font-size: 14px;
        }


        .user-details {

            display: flex;

            flex-direction: column;

            gap: 3px;
        }


        .user-details strong {

            color: var(--admin-text);

            font-size: 13px;
        }


        .user-details span {

            color: var(--admin-muted);

            font-size: 11px;
        }


        /* =================================================
           BALANCE
        ================================================= */

        .user-balance {

            font-weight: bold;

            color: var(--admin-text);
        }


        .user-cashback {

            color: var(--admin-accent);

            font-weight: 600;
        }


        /* =================================================
           STATUS
        ================================================= */

        .user-status {

            display: inline-flex;

            align-items: center;

            gap: 6px;

            padding: 5px 9px;

            border-radius: 20px;

            font-size: 10px;

            font-weight: bold;
        }


        .user-status::before {

            content: "";

            width: 6px;

            height: 6px;

            border-radius: 50%;

            background: currentColor;
        }


        .user-status.active {

            color: #22c55e;

            background:
                rgba(34,197,94,.10);
        }


        .user-status.suspended {

            color: #ef4444;

            background:
                rgba(239,68,68,.10);
        }


        .user-status.pending {

            color: #f59e0b;

            background:
                rgba(245,158,11,.10);
        }


        /* =================================================
           ACTIONS
        ================================================= */

        .user-actions {

            display: flex;

            align-items: center;

            gap: 6px;
        }


        .user-action {

            width: 32px;

            height: 32px;

            border-radius: 8px;

            display: flex;

            align-items: center;

            justify-content: center;

            text-decoration: none;

            font-size: 13px;

            border: 1px solid var(--admin-border);

            color: var(--admin-muted);

            background: transparent;

            transition: .25s ease;
        }


        .user-action:hover {

            color: var(--admin-accent);

            background:
                var(--admin-hover);

            border-color:
                rgba(15,118,110,.20);
        }


        .user-action.danger:hover {

            color: #ef4444;

            background:
                rgba(239,68,68,.08);

            border-color:
                rgba(239,68,68,.20);
        }


        /* =================================================
           PAGINATION
        ================================================= */

        .users-pagination {

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 15px 18px;

            border-top:
                1px solid var(--admin-border);
        }


        .pagination-info {

            color: var(--admin-muted);

            font-size: 12px;
        }


        .pagination-buttons {

            display: flex;

            gap: 5px;
        }


        .pagination-btn {

            min-width: 32px;

            height: 32px;

            padding: 0 8px;

            border-radius: 8px;

            border: 1px solid var(--admin-border);

            background: transparent;

            color: var(--admin-muted);

            cursor: pointer;

            transition: .25s ease;
        }


        .pagination-btn:hover {

            color: var(--admin-accent);

            background:
                var(--admin-hover);
        }


        .pagination-btn.active {

            background:
                var(--admin-accent);

            color: #fff;

            border-color:
                var(--admin-accent);
        }


        /* =================================================
           MOBILE USER CARDS
        ================================================= */

        .mobile-user-list {

            display: none;

            padding: 12px;
        }


        .mobile-user-card {

            background:
                var(--admin-sidebar-2);

            border: 1px solid var(--admin-border);

            border-radius: 14px;

            padding: 15px;

            margin-bottom: 10px;
        }


        .mobile-user-top {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 15px;
        }


        .mobile-user-main {

            display: flex;

            align-items: center;

            gap: 10px;
        }


        .mobile-user-info strong {

            display: block;

            color: var(--admin-text);

            font-size: 14px;

            margin-bottom: 3px;
        }


        .mobile-user-info span {

            color: var(--admin-muted);

            font-size: 11px;
        }


        .mobile-user-data {

            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 10px;

            margin-bottom: 14px;
        }


        .mobile-data-box {

            background:
                var(--admin-sidebar);

            border: 1px solid var(--admin-border);

            border-radius: 9px;

            padding: 10px;
        }


        .mobile-data-box small {

            display: block;

            color: var(--admin-muted);

            font-size: 10px;

            margin-bottom: 4px;
        }


        .mobile-data-box strong {

            color: var(--admin-text);

            font-size: 13px;
        }


        .mobile-user-actions {

            display: grid;

            grid-template-columns: repeat(2,1fr);

            gap: 8px;
        }


        .mobile-user-actions a {

            text-align: center;

            text-decoration: none;

            padding: 9px;

            border-radius: 8px;

            background:
                var(--admin-hover);

            color: var(--admin-accent);

            border: 1px solid var(--admin-border);

            font-size: 12px;
        }


        /* =================================================
           TABLET
        ================================================= */

        @media (max-width: 1100px) {

            .user-stats {

                grid-template-columns:
                    repeat(2,1fr);
            }
        }


        /* =================================================
           SMALL TABLET
        ================================================= */

        @media (max-width: 750px) {

            .users-header {

                align-items: flex-start;

                flex-direction: column;
            }


            .add-user-btn {

                width: 100%;
            }


            .users-toolbar {

                flex-direction: column;

                align-items: stretch;
            }


            .user-filter {

                width: 100%;
            }


            .users-table-wrapper {

                display: none;
            }


            .mobile-user-list {

                display: block;
            }


            .users-pagination {

                flex-direction: column;

                gap: 12px;

                align-items: flex-start;
            }
        }


        /* =================================================
           PHONE
        ================================================= */

        @media (max-width: 500px) {

            .users-title h1 {

                font-size: 23px;
            }


            .users-title p {

                font-size: 13px;
            }


            .user-stats {

                grid-template-columns:
                    repeat(2,1fr);

                gap: 10px;
            }


            .user-stat-card {

                padding: 13px;

                gap: 9px;
            }


            .user-stat-icon {

                width: 40px;

                min-width: 40px;

                height: 40px;

                font-size: 15px;
            }


            .user-stat-info strong {

                font-size: 18px;
            }


            .user-stat-info span {

                font-size: 10px;
            }


            .users-table-header {

                padding: 15px;
            }


            .mobile-user-data {

                grid-template-columns:
                    repeat(2,1fr);
            }
        }


        /* =================================================
           VERY SMALL PHONE
        ================================================= */

        @media (max-width: 350px) {

            .user-stats {

                grid-template-columns: 1fr;
            }


            .mobile-user-data {

                grid-template-columns: 1fr;
            }
        }

    </style>

</head>


<body>


    <!-- =================================================
         SIDEBAR
    ================================================= -->

    

        <%- include('./partials/sidebar') %>


<%- include('partials/alerts') %>

    <!-- =================================================
         MAIN
    ================================================= -->

    <main class="admin-main">

        <section class="users-page">


            <!-- =================================================
                 HEADER
            ================================================= -->

            <header class="users-header">

                <div class="users-title">

                    <h1>
                        Users
                    </h1>

                    <p>
                        Manage and monitor all registered users.
                    </p>

                </div>


                

            </header>


            <!-- =================================================
                 STATISTICS
            ================================================= -->

            <section class="user-stats">


                <!-- TOTAL USERS -->

                <div class="user-stat-card">

                    <div class="user-stat-icon">
                        👥
                    </div>

                    <div class="user-stat-info">

                        <span>
                            Total Users
                        </span>

                        <strong>
                            <%=display.TU%>
                        </strong>

                    </div>

                </div>


                <!-- ACTIVE USERS -->

                <div class="user-stat-card">

                    <div class="user-stat-icon">
                        ✓
                    </div>

                    <div class="user-stat-info">

                        <span>
                            Active Users
                        </span>

                        <strong>
                            <%=act.active%>
                        </strong>

                    </div>

                </div>


                <!-- NEW USERS -->

                <div class="user-stat-card">

                    <div class="user-stat-icon">
                        +
                    </div>

                    <div class="user-stat-info">

                        <span>
                            New Users
                        </span>

                        <strong>
                            <%=New.new%>
                        </strong>

                    </div>

                </div>


                <!-- SUSPENDED -->

                <div class="user-stat-card">

                    <div class="user-stat-icon">
                        !
                    </div>

                    <div class="user-stat-info">

                        <span>
                            Suspended
                        </span>

                        <strong>
                            <%=sus.sus%>
                        </strong>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 SEARCH / FILTER
            ================================================= -->

            <section class="users-toolbar">


                <div class="user-search">

                    <input
                        type="text"
                        placeholder="Search by name, email or phone..."
                    >

                </div>


                <select class="user-filter">

                    <option value="all">
                        All Users
                    </option>

                    <option value="active">
                        Active
                    </option>

                    <option value="suspended">
                        Suspended
                    </option>

                    <option value="pending">
                        Pending
                    </option>

                </select>


            </section>


            <!-- =================================================
                 USERS TABLE
            ================================================= -->

            <section class="users-table-card">


                <div class="users-table-header">

                    <h2>
                        User List
                    </h2>

                    <span class="users-count">
                        <%= display.TU%> users
                    </span>

                </div>


                <!-- =================================================
                     DESKTOP TABLE
                ================================================= -->

                <div class="users-table-wrapper">

                    <table class="users-table">

                        <thead>

                            <tr>

                                <th>
                                    User
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th>
                                    Balance
                                </th>

                                <th>
                                    Cashback
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Joined
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>
                            <% users.slice(0,50).forEach(item => { %>
                                <tr>

                                <td>

                                    <div class="user-profile">

                                        <div class="user-avatar">
                                            <%=item.id%>
                                        </div>

                                        <div class="user-details">

                                            <strong>
                                                <%=item.fname%> <%=item.lname%>
                                            </strong>

                                            <span>
                                               <%=item.email%>
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <td>
                                    <%=item.phone%>
                                </td>


                                <td>

                                    <span class="user-balance">
                                        ₦<%= Number(item.bal).toLocaleString() %>.00
                                    </span>

                                </td>


                                <td>

                                    <span class="user-cashback">
                                        ₦<%= Number(item.cashBack).toLocaleString() %>.00
                                    </span>

                                </td>


                                <td>
                                    <%if(item.acc_status === 'active'){%>
                                    <span class="user-status active">
                                        <%=item.acc_status%>
                                    </span>
                                    <%}else{%>
                                        <span class="user-status suspended">
                                        <%=item.acc_status%>
                                    </span>
                                    <%}%>
                                </td>


                                <td>
                                    <%= new Date(item.date_Joined).toDateString() %>
                                </td>


                                <td>

                                    <div class="user-actions">

                                        <a
                                            href="/admin/users/<%=item.id%>/view"
                                            class="user-action"
                                            title="View"
                                        >
                                            👁
                                        </a>

                                        <a
                                            href="/admin/users/<%=item.id%>/view"
                                            class="user-action"
                                            title="Edit"
                                        >
                                            ✎
                                        </a>
                                        <%if(item.acc_status === 'active'){%>
                                        <a
                                            href="/admin/users/<%=item.id%>/suspend"
                                            class="user-action danger"
                                            title="Suspend"
                                        >
                                            !
                                        </a>
                                        <%}else{%>
                                        <a
                                            href="/admin/users/<%=item.id%>/activate"
                                            class="user-action"
                                            title="Activate"
                                        >
                                            A
                                        </a>
                                        <%}%>
                                    </div>

                                </td>

                            </tr>


                            <% }) %>    
                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     MOBILE USERS
                ================================================= -->

                <div class="mobile-user-list">


                    <!-- MOBILE USER 1 -->
                     <% users.slice(0,50).forEach(item => { %>
                            <article class="mobile-user-card">

                        <div class="mobile-user-top">

                            <div class="mobile-user-main">

                                <div class="user-avatar">
                                    JO
                                </div>

                                <div class="mobile-user-info">

                                    <strong>
                                        <%=item.fname%> <%=item.lname%>
                                    </strong>

                                    <span>
                                        <%=item.email%>
                                    </span>

                                </div>

                            </div>

                                    <%if(item.acc_status === 'active'){%>
                                    <span class="user-status active">
                                        <%=item.acc_status%>
                                    </span>
                                    <%}else{%>
                                        <span class="user-status suspended">
                                        <%=item.acc_status%>
                                    </span>
                                    <%}%>

                        </div>


                        <div class="mobile-user-data">

                            <div class="mobile-data-box">

                                <small>
                                    Phone
                                </small>

                                <strong>
                                    <%=item.phone%>
                                </strong>

                            </div>


                            <div class="mobile-data-box">

                                <small>
                                    Balance
                                </small>

                                <strong>
                                    ₦<%= Number(item.bal).toLocaleString() %>.00
                                </strong>

                            </div>


                            <div class="mobile-data-box">

                                <small>
                                    Cashback
                                </small>

                                <strong>
                                    ₦<%= Number(item.cashBack).toLocaleString() %>.00
                                </strong>

                            </div>


                            <div class="mobile-data-box">

                                <small>
                                    Joined
                                </small>

                                <strong>
                                    <%= new Date(item.date_Joined).toDateString() %>
                                </strong>

                            </div>

                        </div>


                        <div class="mobile-user-actions">

                            <a href="/admin/users/<%=item.id%>/view">
                                View User
                            </a>

                            <a href="/admin/users/<%=item.id%>/view">
                                Edit User
                            </a>

                        </div>

                    </article>


                

                     <%})%>
                    

                </div>
                    

                <!-- =================================================
                     PAGINATION
                ================================================= -->

                <div class="users-pagination">

                    <span class="pagination-info">

                        Showing 1–10 of 12,540 users

                    </span>


                    <div class="pagination-buttons">

                        <button class="pagination-btn">
                            ‹
                        </button>

                        <button class="pagination-btn active">
                            1
                        </button>

                        <button class="pagination-btn">
                            2
                        </button>

                        <button class="pagination-btn">
                            3
                        </button>

                        <button class="pagination-btn">
                            …
                        </button>

                        <button class="pagination-btn">
                            ›
                        </button>

                    </div>

                </div>

            </section>


        </section>

    </main>


</body>

</html>