<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Admin Settings</title>


    <style>

        /* =====================================================
           THEME VARIABLES
        ===================================================== */

        :root {

            /* DARK MODE */

            --bg: #100909;

            --card: #1b1111;

            --card-2: #241616;

            --brand: #250d0d;

            --brand-light: #3a1818;

            --accent: #f5c451;

            --accent-dark: #d99a18;

            --text: #ffffff;

            --muted: #b9afaf;

            --border: rgba(255,255,255,.08);

            --success: #22c55e;

            --danger: #ef4444;

            --warning: #f59e0b;

            --shadow:
                0 12px 30px rgba(0,0,0,.30);
        }


        /* =====================================================
           LIGHT MODE
        ===================================================== */

        [data-theme="light"] {

            --bg: #f4f8f6;

            --card: #ffffff;

            --card-2: #f0f7f5;

            --brand: #0b1f33;

            --brand-light: #163b5c;

            --accent: #0f766e;

            --accent-dark: #0b5f59;

            --text: #10202f;

            --muted: #64748b;

            --border: rgba(11,31,51,.10);

            --success: #16a34a;

            --danger: #dc2626;

            --warning: #d97706;

            --shadow:
                0 12px 30px rgba(11,31,51,.10);
        }


        /* =====================================================
           RESET
        ===================================================== */

        * {

            margin: 0;

            padding: 0;

            box-sizing: border-box;

            font-family:
                Arial,
                Helvetica,
                sans-serif;
        }


        body {

            background: var(--bg);

            color: var(--text);

            min-height: 100vh;

            transition:
                background .3s ease,
                color .3s ease;
        }


        /* =====================================================
           MAIN CONTENT
        ===================================================== */

        .admin-main {

            margin-left: 250px;

            padding: 25px;

            min-height: 100vh;
        }


        /* =====================================================
           PAGE HEADER
        ===================================================== */

        .page-header {

            margin-bottom: 25px;
        }


        .page-header h1 {

            font-size: 28px;

            margin-bottom: 6px;
        }


        .page-header p {

            color: var(--muted);

            font-size: 14px;
        }


        /* =====================================================
           SETTINGS LAYOUT
        ===================================================== */

        .settings-layout {

            display: grid;

            grid-template-columns: 220px 1fr;

            gap: 20px;

            align-items: start;
        }


        /* =====================================================
           SETTINGS MENU
        ===================================================== */

        .settings-menu {

            background: var(--card);

            border: 1px solid var(--border);

            border-radius: 15px;

            padding: 10px;

            box-shadow: var(--shadow);

            position: sticky;

            top: 20px;
        }


        .settings-menu button {

            width: 100%;

            border: none;

            background: transparent;

            color: var(--muted);

            text-align: left;

            padding: 12px;

            border-radius: 9px;

            cursor: pointer;

            font-size: 13px;

            margin-bottom: 3px;

            transition: .25s;
        }


        .settings-menu button:hover {

            background: var(--card-2);

            color: var(--text);
        }


        .settings-menu button.active {

            background: var(--accent);

            color: #fff;

            font-weight: bold;
        }


        /* =====================================================
           SETTINGS CONTENT
        ===================================================== */

        .settings-content {

            display: flex;

            flex-direction: column;

            gap: 20px;
        }


        .settings-card {

            background: var(--card);

            border: 1px solid var(--border);

            border-radius: 16px;

            padding: 22px;

            box-shadow: var(--shadow);
        }


        .settings-card-header {

            padding-bottom: 15px;

            margin-bottom: 18px;

            border-bottom:
                1px solid var(--border);
        }


        .settings-card-header h2 {

            font-size: 18px;

            margin-bottom: 5px;
        }


        .settings-card-header p {

            color: var(--muted);

            font-size: 13px;

            line-height: 1.5;
        }


        /* =====================================================
           FORM GRID
        ===================================================== */

        .form-grid {

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 16px;
        }


        .form-group {

            display: flex;

            flex-direction: column;

            gap: 7px;
        }


        .form-group.full {

            grid-column: 1 / -1;
        }


        .form-group label {

            font-size: 13px;

            font-weight: bold;
        }


        .form-group small {

            color: var(--muted);

            font-size: 11px;
        }


        input,
        select,
        textarea {

            width: 100%;

            border: 1px solid var(--border);

            background: var(--card-2);

            color: var(--text);

            border-radius: 9px;

            outline: none;

            transition: .25s;
        }


        input,
        select {

            height: 44px;

            padding: 0 12px;
        }


        textarea {

            min-height: 100px;

            padding: 12px;

            resize: vertical;
        }


        input:focus,
        select:focus,
        textarea:focus {

            border-color: var(--accent);
        }


        /* =====================================================
           PASSWORD
        ===================================================== */

        .password-wrapper {

            position: relative;
        }


        .password-wrapper input {

            padding-right: 45px;
        }


        .show-password {

            position: absolute;

            right: 12px;

            top: 50%;

            transform: translateY(-50%);

            border: none;

            background: transparent;

            color: var(--muted);

            cursor: pointer;
        }


        /* =====================================================
           TOGGLE ROW
        ===================================================== */

        .setting-row {

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 20px;

            padding: 15px 0;

            border-bottom:
                1px solid var(--border);
        }


        .setting-row:last-child {

            border-bottom: none;

            padding-bottom: 0;
        }


        .setting-info {

            flex: 1;
        }


        .setting-info h3 {

            font-size: 14px;

            margin-bottom: 4px;
        }


        .setting-info p {

            color: var(--muted);

            font-size: 12px;

            line-height: 1.5;
        }


        /* =====================================================
           TOGGLE
        ===================================================== */

        .switch {

            position: relative;

            width: 48px;

            height: 26px;

            flex-shrink: 0;
        }


        .switch input {

            opacity: 0;

            width: 0;

            height: 0;
        }


        .slider {

            position: absolute;

            inset: 0;

            background: #555;

            border-radius: 30px;

            cursor: pointer;

            transition: .3s;
        }


        .slider::before {

            content: "";

            position: absolute;

            width: 20px;

            height: 20px;

            left: 3px;

            top: 3px;

            background: #fff;

            border-radius: 50%;

            transition: .3s;
        }


        .switch input:checked + .slider {

            background: var(--accent);
        }


        .switch input:checked + .slider::before {

            transform:
                translateX(22px);
        }


        /* =====================================================
           STATUS BADGE
        ===================================================== */

        .status {

            display: inline-flex;

            align-items: center;

            gap: 6px;

            padding: 5px 9px;

            border-radius: 20px;

            font-size: 11px;

            font-weight: bold;
        }


        .status.active {

            background:
                rgba(34,197,94,.10);

            color: var(--success);
        }


        .status.warning {

            background:
                rgba(245,158,11,.10);

            color: var(--warning);
        }


        /* =====================================================
           THEME OPTIONS
        ===================================================== */

        .theme-options {

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 15px;
        }


        .theme-option {

            border: 2px solid var(--border);

            border-radius: 13px;

            padding: 15px;

            cursor: pointer;

            transition: .25s;
        }


        .theme-option:hover {

            border-color: var(--accent);
        }


        .theme-option.selected {

            border-color: var(--accent);
        }


        .theme-preview {

            height: 90px;

            border-radius: 9px;

            margin-bottom: 12px;

            display: flex;

            overflow: hidden;
        }


        .dark-preview {

            background: #100909;
        }


        .dark-preview .preview-sidebar {

            width: 30%;

            background: #170707;
        }


        .dark-preview .preview-content {

            flex: 1;

            padding: 10px;
        }


        .dark-preview .preview-box {

            height: 18px;

            background: #3a1818;

            border-radius: 5px;

            margin-bottom: 7px;
        }


        .light-preview {

            background: #f4f8f6;
        }


        .light-preview .preview-sidebar {

            width: 30%;

            background: #0b1f33;
        }


        .light-preview .preview-content {

            flex: 1;

            padding: 10px;
        }


        .light-preview .preview-box {

            height: 18px;

            background: #0f766e;

            border-radius: 5px;

            margin-bottom: 7px;
        }


        .theme-option h3 {

            font-size: 14px;

            margin-bottom: 3px;
        }


        .theme-option p {

            color: var(--muted);

            font-size: 11px;
        }


        /* =====================================================
           DANGER ZONE
        ===================================================== */

        .danger-zone {

            border-color:
                rgba(239,68,68,.25);
        }


        .danger-zone .settings-card-header h2 {

            color: var(--danger);
        }


        .danger-btn {

            border: 1px solid
                rgba(239,68,68,.30);

            background:
                rgba(239,68,68,.08);

            color: var(--danger);

            padding: 10px 15px;

            border-radius: 8px;

            cursor: pointer;

            font-weight: bold;
        }


        /* =====================================================
           BUTTONS
        ===================================================== */

        .form-actions {

            display: flex;

            justify-content: flex-end;

            gap: 10px;

            margin-top: 20px;

            padding-top: 18px;

            border-top:
                1px solid var(--border);
        }


        .save-btn {

            border: none;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: #fff;

            padding: 11px 20px;

            border-radius: 9px;

            font-weight: bold;

            cursor: pointer;
        }


        .reset-btn {

            border: 1px solid var(--border);

            background: transparent;

            color: var(--text);

            padding: 11px 20px;

            border-radius: 9px;

            cursor: pointer;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media(max-width: 900px) {

            .admin-main {

                margin-left: 230px;
            }


            .settings-layout {

                grid-template-columns: 180px 1fr;
            }
        }


        @media(max-width: 700px) {

            .admin-main {

                margin-left: 0;

                padding:
                    80px 15px 20px;
            }


            .settings-layout {

                display: block;
            }


            .settings-menu {

                position: static;

                display: flex;

                overflow-x: auto;

                margin-bottom: 20px;

                gap: 5px;
            }


            .settings-menu button {

                min-width: max-content;

                margin-bottom: 0;
            }


            .form-grid {

                grid-template-columns: 1fr;
            }


            .form-group.full {

                grid-column: auto;
            }
        }


        @media(max-width: 500px) {

            .settings-card {

                padding: 16px;
            }


            .theme-options {

                grid-template-columns: 1fr;
            }


            .setting-row {

                align-items: flex-start;
            }


            .form-actions {

                flex-direction: column;
            }


            .save-btn,
            .reset-btn {

                width: 100%;
            }
        }

    </style>

</head>


<body data-theme="dark">


    
         <%- include('./partials/sidebar') %>

         

   


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="admin-main">


        <!-- HEADER -->

        <div class="page-header">

            <h1>
                Settings
            </h1>

            <p>
                Manage your platform and administrator settings.
            </p>

        </div>



        <div class="settings-layout">


            <!-- =================================================
                 SETTINGS MENU
            ================================================== -->

            <aside class="settings-menu">

                <button
                    class="active"
                    onclick="showSection('account', this)"
                >
                    Account
                </button>


                <button
                    onclick="showSection('website', this)"
                >
                    Website
                </button>


                <button
                    onclick="showSection('services', this)"
                >
                    Services
                </button>


                <button
                    onclick="showSection('notifications', this)"
                >
                    Notifications
                </button>


                <button
                    onclick="showSection('appearance', this)"
                >
                    Appearance
                </button>


                <button
                    onclick="showSection('security', this)"
                >
                    Security
                </button>


                <button
                    onclick="showSection('danger', this)"
                >
                    Danger Zone
                </button>

            </aside>



            <!-- =================================================
                 SETTINGS CONTENT
            ================================================== -->

            <div class="settings-content">



                <!-- =================================================
                     ACCOUNT
                ================================================== -->

                <section
                    class="settings-card settings-section"
                    id="account"
                >

                    <div class="settings-card-header">

                        <h2>
                            Administrator Account
                        </h2>

                        <p>
                            Update your administrator account
                            information.
                        </p>

                    </div>


                    <div class="form-grid">


                        <div class="form-group">

                            <label>
                                Admin Name
                            </label>

                            <input
                                type="text"
                                placeholder="Administrator name"
                                value="Admin"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Email Address
                            </label>

                            <input
                                type="email"
                                placeholder="admin@example.com"
                                value="admin@example.com"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Phone Number
                            </label>

                            <input
                                type="tel"
                                placeholder="Phone number"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Role
                            </label>

                            <input
                                type="text"
                                value="Administrator"
                                disabled
                            >

                        </div>


                    </div>


                    <div class="form-actions">

                        <button class="reset-btn">
                            Reset
                        </button>

                        <button class="save-btn">
                            Save Changes
                        </button>

                    </div>

                </section>



                <!-- =================================================
                     WEBSITE
                ================================================== -->

                <section
                    class="settings-card settings-section"
                    id="website"
                    style="display:none;"
                >

                    <div class="settings-card-header">

                        <h2>
                            Website Settings
                        </h2>

                        <p>
                            Manage your platform's basic
                            information.
                        </p>

                    </div>


                    <div class="form-grid">


                        <div class="form-group">

                            <label>
                                Website Name
                            </label>

                            <input
                                type="text"
                                value="Zaki Sub"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Support Email
                            </label>

                            <input
                                type="email"
                                placeholder="support@example.com"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Support Phone
                            </label>

                            <input
                                type="tel"
                                placeholder="Support phone"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Currency
                            </label>

                            <select>

                                <option selected>
                                    Nigerian Naira (₦)
                                </option>

                                <option>
                                    US Dollar ($)
                                </option>

                            </select>

                        </div>


                        <div class="form-group full">

                            <label>
                                Website Description
                            </label>

                            <textarea
                                placeholder="Describe your platform..."
                            ></textarea>

                        </div>


                    </div>


                    <div class="form-actions">

                        <button class="save-btn">
                            Save Website Settings
                        </button>

                    </div>

                </section>



                <!-- =================================================
                     SERVICES
                ================================================== -->

                <section
                    class="settings-card settings-section"
                    id="services"
                    style="display:none;"
                >

                    <div class="settings-card-header">

                        <h2>
                            Service Settings
                        </h2>

                        <p>
                            Control the availability of
                            services on your platform.
                        </p>

                    </div>


                    <!-- AIRTIME -->

                    <div class="setting-row">

                        <div class="setting-info">

                            <h3>
                                Airtime Service
                            </h3>

                            <p>
                                Allow users to purchase
                                airtime.
                            </p>

                        </div>


                        <label class="switch">

                            <input
                                type="checkbox"
                                checked
                            >

                            <span class="slider"></span>

                        </label>

                    </div>


                    <!-- DATA -->

                    <div class="setting-row">

                        <div class="setting-info">

                            <h3>
                                Data Service
                            </h3>

                            <p>
                                Allow users to purchase
                                data bundles.
                            </p>

                        </div>


                        <label class="switch">

                            <input
                                type="checkbox"
                                checked
                            >

                            <span class="slider"></span>

                        </label>

                    </div>


                    <!-- WALLET -->

                    <div class="setting-row">

                        <div class="setting-info">

                            <h3>
                                Wallet Funding
                            </h3>

                            <p>
                                Allow users to fund their
                                wallet.
                            </p>

                        </div>


                        <label class="switch">

                            <input
                                type="checkbox"
                                checked
                            >

                            <span class="slider"></span>

                        </label>

                    </div>


                    <!-- REGISTRATION -->

                    <div class="setting-row">

                        <div class="setting-info">

                            <h3>
                                New Registrations
                            </h3>

                            <p>
                                Allow new users to create
                                accounts.
                            </p>

                        </div>


                        <label class="switch">

                            <input
                                type="checkbox"
                                checked
                            >

                            <span class="slider"></span>

                        </label>

                    </div>


                    <!-- MAINTENANCE -->

                    <div class="setting-row">

                        <div class="setting-info">

                            <h3>
                                Maintenance Mode
                            </h3>

                            <p>
                                Temporarily disable normal
                                platform access.
                            </p>

                        </div>


                        <label class="switch">

                            <input
                                type="checkbox"
                            >

                            <span class="slider"></span>

                        </label>

                    </div>


                </section>



                <!-- =================================================
                     NOTIFICATIONS
                ================================================== -->

                <section
                    class="settings-card settings-section"
                    id="notifications"
                    style="display:none;"
                >

                    <div class="settings-card-header">

                        <h2>
                            Notifications
                        </h2>

                        <p>
                            Control administrator
                            notifications.
                        </p>

                    </div>


                    <div class="setting-row">

                        <div class="setting-info">

                            <h3>
                                New User Notification
                            </h3>

                            <p>
                                Notify you when a new user
                                registers.
                            </p>

                        </div>


                        <label class="switch">

                            <input
                                type="checkbox"
                                checked
                            >

                            <span class="slider"></span>

                        </label>

                    </div>


                    <div class="setting-row">

                        <div class="setting-info">

                            <h3>
                                Failed Transaction Alert
                            </h3>

                            <p>
                                Notify you when a transaction
                                fails.
                            </p>

                        </div>


                        <label class="switch">

                            <input
                                type="checkbox"
                                checked
                            >

                            <span class="slider"></span>

                        </label>

                    </div>


                    <div class="setting-row">

                        <div class="setting-info">

                            <h3>
                                Pending Transaction Alert
                            </h3>

                            <p>
                                Notify you about transactions
                                that remain pending.
                            </p>

                        </div>


                        <label class="switch">

                            <input
                                type="checkbox"
                                checked
                            >

                            <span class="slider"></span>

                        </label>

                    </div>


                    <div class="setting-row">

                        <div class="setting-info">

                            <h3>
                                Wallet Deposit Alert
                            </h3>

                            <p>
                                Notify you when users fund
                                their wallets.
                            </p>

                        </div>


                        <label class="switch">

                            <input
                                type="checkbox"
                                checked
                            >

                            <span class="slider"></span>

                        </label>

                    </div>

                </section>



                <!-- =================================================
                     APPEARANCE
                ================================================== -->

                <section
                    class="settings-card settings-section"
                    id="appearance"
                    style="display:none;"
                >

                    <div class="settings-card-header">

                        <h2>
                            Appearance
                        </h2>

                        <p>
                            Choose the appearance of your
                            admin dashboard.
                        </p>

                    </div>


                    <div class="theme-options">


                        <!-- DARK -->

                        <div
                            class="theme-option selected"
                            onclick="changeTheme('dark', this)"
                        >

                            <div
                                class="theme-preview dark-preview"
                            >

                                <div
                                    class="preview-sidebar"
                                ></div>


                                <div
                                    class="preview-content"
                                >

                                    <div
                                        class="preview-box"
                                    ></div>

                                    <div
                                        class="preview-box"
                                    ></div>

                                    <div
                                        class="preview-box"
                                    ></div>

                                </div>

                            </div>


                            <h3>
                                Dark Mode
                            </h3>

                            <p>
                                Brown, black and gold.
                            </p>

                        </div>



                        <!-- LIGHT -->

                        <div
                            class="theme-option"
                            onclick="changeTheme('light', this)"
                        >

                            <div
                                class="theme-preview light-preview"
                            >

                                <div
                                    class="preview-sidebar"
                                ></div>


                                <div
                                    class="preview-content"
                                >

                                    <div
                                        class="preview-box"
                                    ></div>

                                    <div
                                        class="preview-box"
                                    ></div>

                                    <div
                                        class="preview-box"
                                    ></div>

                                </div>

                            </div>


                            <h3>
                                Light Mode
                            </h3>

                            <p>
                                Emerald, navy and gold.
                            </p>

                        </div>


                    </div>

                </section>



                <!-- =================================================
                     SECURITY
                ================================================== -->

                <section
                    class="settings-card settings-section"
                    id="security"
                    style="display:none;"
                >

                    <div class="settings-card-header">

                        <h2>
                            Security
                        </h2>

                        <p>
                            Manage your administrator
                            account security.
                        </p>

                    </div>


                    <div class="form-grid">


                        <div class="form-group full">

                            <label>
                                Current Password
                            </label>

                            <div
                                class="password-wrapper"
                            >

                                <input
                                    type="password"
                                    placeholder="Current password"
                                >

                            </div>

                        </div>


                        <div class="form-group">

                            <label>
                                New Password
                            </label>

                            <input
                                type="password"
                                placeholder="New password"
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Confirm Password
                            </label>

                            <input
                                type="password"
                                placeholder="Confirm password"
                            >

                        </div>


