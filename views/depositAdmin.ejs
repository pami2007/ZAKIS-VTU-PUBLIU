
<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/x-icon" href="/images/zaki_logo.png">

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Admin Deposits - Zaki Sub</title>
    <script src="/js/publicTheme.js"></script>


    <style>

        /* =====================================================
           THEME
        ===================================================== */

        :root {

            /* DARK MODE */

            --bg: #100909;

            --surface: #1B1111;

            --surface-2: #241616;

            --brand: #250D0D;

            --brand-light: #3A1818;

            --accent: #F5C451;

            --accent-dark: #D99A18;

            --text: #FFFFFF;

            --muted: #B9AFAF;

            --border: rgba(255,255,255,.08);

            --hover: rgba(245,196,81,.07);

            --success: #22C55E;

            --danger: #EF4444;

            --warning: #F59E0B;

            --info: #3B82F6;

            --shadow:
                0 10px 30px rgba(0,0,0,.25);
        }


        /* LIGHT MODE */

        [data-theme="light"] {

            --bg: #F4F8F6;

            --surface: #FFFFFF;

            --surface-2: #F0F7F5;

            --brand: #0B1F33;

            --brand-light: #163B5C;

            --accent: #0F766E;

            --accent-dark: #0B5F59;

            --text: #10202F;

            --muted: #64748B;

            --border: rgba(11,31,51,.10);

            --hover: rgba(15,118,110,.06);

            --success: #16A34A;

            --danger: #DC2626;

            --warning: #D97706;

            --info: #2563EB;

            --shadow:
                0 10px 30px rgba(11,31,51,.08);
        }


        /* =====================================================
           RESET
        ===================================================== */

        * {

            margin: 0;

            padding: 0;

            box-sizing: border-box;

            font-family:
                Arial,
                Helvetica,
                sans-serif;
        }


        body {

            background: var(--bg);

            color: var(--text);

            transition:
                background .3s ease,
                color .3s ease;
        }


        /* =====================================================
           PAGE
        ===================================================== */

        .deposit-page {

            width: 100%;

            max-width: 1400px;

            margin: auto;

            padding: 25px;
        }


        /* =====================================================
           PAGE HEADER
        ===================================================== */

        .page-header {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 25px;
        }


        .page-title h1 {

            font-size: 27px;

            margin-bottom: 6px;
        }


        .page-title p {

            color: var(--muted);

            font-size: 14px;
        }


        /* =====================================================
           REFRESH BUTTON
        ===================================================== */

        .refresh-btn {

            border: 1px solid var(--border);

            background: var(--surface);

            color: var(--text);

            padding: 11px 16px;

            border-radius: 10px;

            text-decoration: none;

            font-size: 13px;

            transition: .3s;
        }


        .refresh-btn:hover {

            background: var(--hover);

            border-color: var(--accent);

            color: var(--accent);
        }


        /* =====================================================
           SUMMARY CARDS
        ===================================================== */

        .deposit-stats {

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 15px;

            margin-bottom: 25px;
        }


        .stat-card {

            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 16px;

            padding: 20px;

            box-shadow: var(--shadow);

            transition: .3s;
        }


        .stat-card:hover {

            transform: translateY(-3px);

            border-color: var(--accent);
        }


        .stat-top {

            display: flex;

            align-items: center;

            justify-content: space-between;

            margin-bottom: 15px;
        }


        .stat-title {

            color: var(--muted);

            font-size: 13px;
        }


        .stat-icon {

            width: 38px;

            height: 38px;

            border-radius: 10px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: var(--hover);

            color: var(--accent);

            font-size: 17px;
        }


        .stat-card h2 {

            font-size: 23px;

            margin-bottom: 5px;
        }


        .stat-card small {

            color: var(--muted);

            font-size: 11px;
        }


        /* =====================================================
           FILTER AREA
        ===================================================== */

        .deposit-container {

            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 18px;

            box-shadow: var(--shadow);

            overflow: hidden;
        }


        .filter-header {

            padding: 20px;

            border-bottom: 1px solid var(--border);

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 15px;
        }


        .filter-header h3 {

            font-size: 17px;
        }


        .filter-area {

            padding: 18px;

            display: grid;

            grid-template-columns:
                2fr 1fr 1fr auto;

            gap: 12px;

            border-bottom: 1px solid var(--border);

            background: var(--surface-2);
        }


        .search-box,
        .filter-select {

            height: 42px;

            border-radius: 9px;

            border: 1px solid var(--border);

            background: var(--surface);

            color: var(--text);

            padding: 0 13px;

            outline: none;

            font-size: 13px;

            width: 100%;
        }


        .search-box::placeholder {

            color: var(--muted);
        }


        .search-box:focus,
        .filter-select:focus {

            border-color: var(--accent);
        }


        .filter-btn {

            height: 42px;

            border: none;

            border-radius: 9px;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: #fff;

            padding: 0 18px;

            font-weight: bold;

            cursor: pointer;

            font-size: 13px;
        }


        /* =====================================================
           TABLE
        ===================================================== */

        .table-wrapper {

            width: 100%;

            overflow-x: auto;
        }


        .deposit-table {

            width: 100%;

            border-collapse: collapse;

            min-width: 850px;
        }


        .deposit-table th {

            text-align: left;

            padding: 15px 18px;

            color: var(--muted);

            font-size: 11px;

            text-transform: uppercase;

            letter-spacing: .5px;

            background: var(--surface-2);

            border-bottom: 1px solid var(--border);

            white-space: nowrap;
        }


        .deposit-table td {

            padding: 16px 18px;

            border-bottom: 1px solid var(--border);

            font-size: 13px;

            white-space: nowrap;
        }


        .deposit-table tbody tr {

            transition: .25s;
        }


        .deposit-table tbody tr:hover {

            background: var(--hover);
        }


        /* =====================================================
           USER
        ===================================================== */

        .user-info {

            display: flex;

            align-items: center;

            gap: 10px;
        }


        .user-avatar {

            width: 35px;

            height: 35px;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: #111;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 12px;

            font-weight: bold;
        }


        .user-details {

            display: flex;

            flex-direction: column;

            gap: 3px;
        }


        .user-details strong {

            color: var(--text);

            font-size: 13px;
        }


        .user-details span {

            color: var(--muted);

            font-size: 11px;
        }


        /* =====================================================
           AMOUNT
        ===================================================== */

        .deposit-amount {

            font-weight: bold;

            color: var(--text);
        }


        .deposit-fee {

            color: var(--muted);

            font-size: 11px;
        }


        /* =====================================================
           REFERENCE
        ===================================================== */

        .reference {

            color: var(--muted);

            font-size: 11px;

            font-family: monospace;
        }


        /* =====================================================
           STATUS
        ===================================================== */

        .status {

            display: inline-flex;

            align-items: center;

            gap: 5px;

            padding: 5px 9px;

            border-radius: 20px;

            font-size: 10px;

            font-weight: bold;
        }


        .status::before {

            content: "";

            width: 6px;

            height: 6px;

            border-radius: 50%;

            background: currentColor;
        }


        .status-success {

            color: var(--success);

            background: rgba(34,197,94,.10);
        }


        .status-pending {

            color: var(--warning);

            background: rgba(245,158,11,.10);
        }


        .status-failed {

            color: var(--danger);

            background: rgba(239,68,68,.10);
        }


        /* =====================================================
           PAYMENT METHOD
        ===================================================== */

        .payment-method {

            color: var(--text);

            font-size: 12px;

            font-weight: 500;
        }


        /* =====================================================
           ACTION
        ===================================================== */

        .view-btn {

            display: inline-block;

            padding: 7px 11px;

            border-radius: 7px;

            border: 1px solid var(--border);

            color: var(--accent);

            text-decoration: none;

            font-size: 11px;

            transition: .25s;
        }


        .view-btn:hover {

            background: var(--accent);

            color: #fff;

            border-color: var(--accent);
        }


        /* =====================================================
           PAGINATION
        ===================================================== */

        .pagination {

            padding: 18px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;
        }


        .pagination-info {

            color: var(--muted);

            font-size: 12px;
        }


        .pagination-buttons {

            display: flex;

            gap: 6px;
        }


        .page-btn {

            min-width: 34px;

            height: 34px;

            border-radius: 8px;

            border: 1px solid var(--border);

            background: var(--surface);

            color: var(--text);

            text-decoration: none;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 12px;

            transition: .25s;
        }


        .page-btn:hover {

            border-color: var(--accent);

            color: var(--accent);
        }


        .page-btn.active {

            background: var(--accent);

            color: #fff;

            border-color: var(--accent);
        }


        /* =====================================================
           EMPTY STATE
        ===================================================== */

        .empty-state {

            padding: 55px 20px;

            text-align: center;
        }


        .empty-icon {

            width: 55px;

            height: 55px;

            margin: auto auto 15px;

            border-radius: 50%;

            background: var(--hover);

            color: var(--accent);

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 22px;
        }


        .empty-state h3 {

            margin-bottom: 7px;

            font-size: 17px;
        }


        .empty-state p {

            color: var(--muted);

            font-size: 13px;
        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 1000px) {

            .deposit-stats {

                grid-template-columns:
                    repeat(2, 1fr);
            }


            .filter-area {

                grid-template-columns:
                    1fr 1fr;
            }


            .filter-btn {

                width: 100%;
            }
        }


        /* =====================================================
           PHONE
        ===================================================== */

        @media (max-width: 650px) {

            .deposit-page {

                padding: 15px;
            }


            .page-header {

                align-items: flex-start;

                flex-direction: column;
            }


            .page-title h1 {

                font-size: 23px;
            }


            .deposit-stats {

                grid-template-columns: 1fr 1fr;

                gap: 10px;
            }


            .stat-card {

                padding: 15px;
            }


            .stat-card h2 {

                font-size: 18px;
            }


            .stat-title {

                font-size: 11px;
            }


            .filter-area {

                grid-template-columns: 1fr;

                padding: 15px;
            }


            .filter-header {

                padding: 15px;
            }


            .pagination {

                flex-direction: column;

                align-items: flex-start;
            }
        }


        /* =====================================================
           SMALL PHONE
        ===================================================== */

        @media (max-width: 400px) {

            .deposit-stats {

                grid-template-columns: 1fr;
            }


            .deposit-page {

                padding: 12px;
            }
        }

    </style>

</head>


<body>



    <%- include('./partials/sidebar') %>



<main class="admin-main">


    <section class="deposit-page">


        <!-- =================================================
             PAGE HEADER
        ================================================= -->

        <header class="page-header">

            <div class="page-title">

                <h1>
                    Deposits
                </h1>

                <p>
                    Monitor and manage user wallet deposits.
                </p>

            </div>


            <a
                href="#"
                class="refresh-btn"
            >
                ↻ Refresh
            </a>

        </header>


        <!-- =================================================
             SUMMARY
        ================================================= -->

        <section class="deposit-stats">


            <!-- TOTAL -->

            <div class="stat-card">

                <div class="stat-top">

                    <span class="stat-title">
                        Total Deposits
                    </span>

                    <div class="stat-icon">
                        ₦
                    </div>

                </div>

                <h2>
                    
                    ₦<%= Number(displayOD.deposit).toLocaleString() %>.00
                </h2>

                <small>
                    All successful deposits
                </small>

            </div>


            <!-- TODAY -->

            <div class="stat-card">

                <div class="stat-top">

                    <span class="stat-title">
                        Today's Deposits
                    </span>

                    <div class="stat-icon">
                        +
                    </div>

                </div>

                <h2>
                    ₦<%= Number(displayODT.deposit).toLocaleString() %>.00
                </h2>

                <small>
                    Deposits received today
                </small>

            </div>


            <!-- PENDING -->

            <div class="stat-card">

                <div class="stat-top">

                    <span class="stat-title">
                        Pending
                    </span>

                    <div class="stat-icon">
                        ⏳
                    </div>

                </div>

                <h2>
                    ₦<%= Number(displayOPD.deposit).toLocaleString() %>.00
                </h2>

                <small>
                    Awaiting confirmation
                </small>

            </div>


            <!-- FAILED -->

            <div class="stat-card">

                <div class="stat-top">

                    <span class="stat-title">
                        Failed
                    </span>

                    <div class="stat-icon">
                        !
                    </div>

                </div>

                <h2>
                    ₦<%= Number(displayOFD.deposit).toLocaleString() %>.00
                </h2>

                <small>
                    Failed deposit attempts
                </small>

            </div>


        </section>


        <!-- =================================================
             DEPOSIT CONTAINER
        ================================================= -->

        <section class="deposit-container">


            <!-- HEADER -->

            <div class="filter-header">

                <h3>
                    Deposit Transactions
                </h3>

            </div>


            <!-- =================================================
                 FILTER
            ================================================= -->

            <div class="filter-area">


                <input
                    type="text"
                    class="search-box"
                    placeholder="Search user or reference..."
                >


                <select class="filter-select">

                    <option value="">
                        All Status
                    </option>

                    <option value="successful">
                        Successful
                    </option>

                    <option value="pending">
                        Pending
                    </option>

                    <option value="failed">
                        Failed
                    </option>

                </select>


                <select class="filter-select">

                    <option value="">
                        All Methods
                    </option>

                    <option value="monnify">
                        Monnify
                    </option>

                    <option value="bank">
                        Bank Transfer
                    </option>

                </select>


                <button
                    type="button"
                    class="filter-btn"
                >
                    Filter
                </button>


            </div>


            <!-- =================================================
                 TABLE
            ================================================= -->

            <div class="table-wrapper">

                <table class="deposit-table">

                    <thead>

                        <tr>

                            <th>
                                User
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Fee
                            </th>

                            <th>
                                Reference
                            </th>

                            <th>
                                Method
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>
                        <% displaydetails.slice(0,10).forEach(item => { %>
                            <!-- =====================================
                             DEPOSIT 1
                        ====================================== -->

                       <tr>

                            <td>

                                <div class="user-info">

                                     <div class="user-avatar">
                                        <%=item.id%>
                                    </div>

                                    <div class="user-details">

                                        <strong>
                                            user ID
                                        </strong>

                                        <span>
                                            <%=item.userId%>
                                        </span>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <div class="deposit-amount">
                                    ₦<%= Number(item.amount).toLocaleString() %>.00
                                </div>

                            </td>


                            <td>

                                <span class="deposit-fee">
                                    ₦<%= Number(item.amount_paid).toLocaleString() %>.00
                                </span>

                            </td>


                            <td>

                                <span class="reference">
                                    <%=item.ref_id%>
                                </span>

                            </td>


                            <td>

                                <span class="payment-method">
                                    Monnify
                                </span>

                            </td>


                            <td>

                                
                                <%= new Date(item.dates).toLocaleString() %>

                            </td>


                            <td>

                                <%if(item.status ==='SUCCESSFUL'){%>
                                <span class="status status-success">                   
                                    <%=item.status%>
                                </span> 

                                   <%}else if(item.status==='FAILED'){%>
                                   <span class="status status-failed">
                                    <%=item.status%>
                                  </span> 

                                   <%}else{%>
                                  <span class="status status-pending">
                                    <%=item.status%>
                                   </span> 
                                <%}%>

                            </td>


                            <td>

                                <a
                                    href="/admin/<%=item.id%>/receipt"
                                    class="view-btn"
                                >
                                    View
                                </a>

                            </td>

                        </tr>
                        <%})%>
                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 PAGINATION
            ================================================= -->

            <div class="pagination">

                <div class="pagination-info">

                    Showing 1 - 4 of 120 deposits

                </div>


                <div class="pagination-buttons">

                    <a
                        href="#"
                        class="page-btn"
                    >
                        ‹
                    </a>


                    <a
                        href="#"
                        class="page-btn active"
                    >
                        1
                    </a>


                    <a
                        href="#"
                        class="page-btn"
                    >
                        2
                    </a>


                    <a
                        href="#"
                        class="page-btn"
                    >
                        3
                    </a>


                    <a
                        href="#"
                        class="page-btn"
                    >
                        ›
                    </a>

                </div>

            </div>


        </section>


    </section>

</main>


</body>

</html>

