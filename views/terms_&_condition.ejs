<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Terms & Conditions - Zaki Sub</title>

    <link
        rel="icon"
        type="image/x-icon"
        href="/images/zaki_logo.png"
    >

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        :root {
            --bg: #100909;
            --card: #190b0b;
            --border: rgba(255,255,255,.08);
            --text: #fff;
            --muted: #b9aaaa;
            --accent: #F5C451;
            --accent-dark: #D99A18;
        }

        [data-theme="light"] {
            --bg: #F4F8F6;
            --card: #fff;
            --border: rgba(11,31,51,.10);
            --text: #10202F;
            --muted: #64748B;
            --accent: #0F766E;
            --accent-dark: #0B5F59;
        }

        body {
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            padding: 20px;
            transition: .3s;
        }

        .container {
            width: 100%;
            max-width: 800px;
            margin: 40px auto;
        }

        .header {
            text-align: center;
            margin-bottom: 25px;
        }

        .logo {
            font-size: 27px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .logo span {
            color: var(--accent);
        }

        .header p {
            color: var(--muted);
            font-size: 14px;
        }

        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 15px 40px rgba(0,0,0,.15);
        }

        .card h1 {
            font-size: 25px;
            margin-bottom: 8px;
        }

        .updated {
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 30px;
        }

        .section {
            margin-bottom: 25px;
        }

        .section h2 {
            font-size: 17px;
            margin-bottom: 8px;
            color: var(--accent);
        }

        .section p {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.7;
        }

        .section ul {
            padding-left: 20px;
            color: var(--muted);
        }

        .section li {
            font-size: 14px;
            line-height: 1.7;
            margin-bottom: 5px;
        }

        .back {
            display: block;
            width: 180px;
            text-align: center;
            margin: 25px auto 0;
            padding: 13px;
            border-radius: 10px;
            background: linear-gradient(
                135deg,
                var(--accent),
                var(--accent-dark)
            );
            color: #fff;
            text-decoration: none;
            font-weight: bold;
        }

        .theme-btn {
            position: fixed;
            top: 20px;
            right: 20px;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: var(--card);
            color: var(--text);
            cursor: pointer;
        }

        @media(max-width:600px) {

            body {
                padding: 15px;
            }

            .container {
                margin: 30px auto;
            }

            .card {
                padding: 22px;
            }

            .card h1 {
                font-size: 22px;
            }

        }

    </style>

</head>

<body>


<button
    class="theme-btn"
    id="themeBtn"
>
    ◐
</button>


<div class="container">


    <div class="header">

        <div class="logo">
            ZAKI <span>SUB</span>
        </div>

        <p>
            Terms and Conditions
        </p>

    </div>


    <div class="card">

        <h1>
            Terms & Conditions
        </h1>

        <p class="updated">
            Last updated: August 2026
        </p>


        <div class="section">

            <h2>1. Acceptance</h2>

            <p>
                By using Zaki Sub, you agree to these Terms
                and Conditions. If you do not agree, please
                do not use our services.
            </p>

        </div>


        <div class="section">

            <h2>2. Our Services</h2>

            <p>
                Zaki Sub provides digital services including
                airtime, data, electricity, TV subscriptions,
                wallet funding and other available services.
            </p>

        </div>


        <div class="section">

            <h2>3. User Account</h2>

            <p>
                You are responsible for keeping your account
                information and password secure. You should
                immediately notify us if you suspect
                unauthorized access to your account.
            </p>

        </div>


        <div class="section">

            <h2>4. Wallet & Payments</h2>

            <p>
                Users are responsible for ensuring that their
                transaction details are correct before making
                a purchase. Successful transactions may not
                be reversible where the service provider has
                already processed the transaction.
            </p>

        </div>


        <div class="section">

            <h2>5. Transactions</h2>

            <p>
                We will make reasonable efforts to process
                transactions promptly. However, delays,
                failures or service interruptions may occur
                due to third-party providers or network issues.
            </p>

        </div>


        <div class="section">

            <h2>6. Prohibited Use</h2>

            <p>
                You must not use Zaki Sub for fraudulent,
                illegal or unauthorized activities. We reserve
                the right to suspend or terminate accounts
                involved in such activities.
            </p>

        </div>


        <div class="section">

            <h2>7. Changes</h2>

            <p>
                We may update these Terms and Conditions from
                time to time. Continued use of Zaki Sub after
                changes means you accept the updated terms.
            </p>

        </div>


        <div class="section">

            <h2>8. Contact</h2>

            <p>
                If you have questions about these terms,
                please contact Zaki Sub support.
            </p>

        </div>


        <a
            href="/"
            class="back"
        >
            Back to Home
        </a>


    </div>

</div>


<script>

    const theme =
        localStorage.getItem("zaki-theme") || "dark";

    document.documentElement.setAttribute(
        "data-theme",
        theme
    );


    document
        .getElementById("themeBtn")
        .addEventListener("click", function () {

            const current =
                document.documentElement.getAttribute(
                    "data-theme"
                ) || "dark";

            const newTheme =
                current === "dark"
                    ? "light"
                    : "dark";

            document.documentElement.setAttribute(
                "data-theme",
                newTheme
            );

            localStorage.setItem(
                "zaki-theme",
                newTheme
            );

        });

</script>

</body>
</html>