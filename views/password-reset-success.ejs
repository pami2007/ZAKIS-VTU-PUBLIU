
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Password Reset Successful</title>


    <style>

        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =====================================================
           DARK MODE
        ===================================================== */

        :root {

            --bg: #250D0D;

            --bg-secondary: #170707;

            --card: rgba(255,255,255,.08);

            --card-border: rgba(255,255,255,.15);

            --text: #ffffff;

            --muted: #d6caca;

            --accent: #F5C451;

            --accent-dark: #D99A18;

            --success: #22C55E;

            --shadow:
                0 20px 50px rgba(0,0,0,.35);
        }


        /* =====================================================
           LIGHT MODE
        ===================================================== */

        [data-theme="light"] {

            --bg: #F4F8F6;

            --bg-secondary: #E8F1EE;

            --card: #ffffff;

            --card-border: rgba(11,31,51,.10);

            --text: #10202F;

            --muted: #64748B;

            --accent: #0F766E;

            --accent-dark: #0B5F59;

            --success: #16A34A;

            --shadow:
                0 20px 50px rgba(11,31,51,.10);
        }


        /* =====================================================
           BODY
        ===================================================== */

        body {

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 20px;

            background:

                radial-gradient(
                    circle at top left,
                    rgba(245,196,81,.10),
                    transparent 35%
                ),

                radial-gradient(
                    circle at bottom right,
                    rgba(15,118,110,.10),
                    transparent 35%
                ),

                var(--bg);

            color: var(--text);

            transition:
                background .3s ease,
                color .3s ease;
        }


        /* =====================================================
           CONTAINER
        ===================================================== */

        .success-container {

            width: 100%;

            max-width: 450px;

            text-align: center;
        }


        /* =====================================================
           BRAND
        ===================================================== */

        .brand {

            margin-bottom: 25px;

            font-size: 28px;

            font-weight: 800;

            letter-spacing: .5px;

            color: var(--text);
        }


        .brand span {

            color: var(--accent);
        }


        /* =====================================================
           CARD
        ===================================================== */

        .success-card {

            background: var(--card);

            border: 1px solid var(--card-border);

            border-radius: 24px;

            padding: 40px 30px;

            box-shadow: var(--shadow);

            backdrop-filter: blur(15px);

            -webkit-backdrop-filter: blur(15px);

            transition:
                background .3s ease,
                border-color .3s ease,
                box-shadow .3s ease;
        }


        /* =====================================================
           SUCCESS ICON
        ===================================================== */

        .success-icon {

            width: 80px;

            height: 80px;

            margin: 0 auto 25px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    var(--success),
                    var(--accent)
                );

            color: white;

            font-size: 38px;

            font-weight: bold;

            box-shadow:
                0 10px 30px
                rgba(34,197,94,.20);

            animation: successPop .5s ease;
        }


        /* =====================================================
           ANIMATION
        ===================================================== */

        @keyframes successPop {

            0% {

                transform: scale(.6);

                opacity: 0;
            }

            70% {

                transform: scale(1.08);
            }

            100% {

                transform: scale(1);

                opacity: 1;
            }
        }


        /* =====================================================
           TITLE
        ===================================================== */

        .success-card h1 {

            font-size: 26px;

            margin-bottom: 12px;

            color: var(--text);
        }


        /* =====================================================
           DESCRIPTION
        ===================================================== */

        .success-card p {

            color: var(--muted);

            font-size: 15px;

            line-height: 1.6;

            margin-bottom: 28px;
        }


        /* =====================================================
           LOGIN BUTTON
        ===================================================== */

        .login-btn {

            display: flex;

            align-items: center;

            justify-content: center;

            width: 100%;

            height: 50px;

            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: white;

            text-decoration: none;

            font-size: 16px;

            font-weight: bold;

            box-shadow:
                0 8px 22px
                rgba(15,118,110,.18);

            transition:
                transform .3s ease,
                box-shadow .3s ease;
        }


        .login-btn:hover {

            transform: translateY(-3px);

            box-shadow:
                0 12px 28px
                rgba(15,118,110,.25);
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .footer {

            margin-top: 25px;

            color: var(--muted);

            font-size: 13px;
        }


        /* =====================================================
           THEME BUTTON
        ===================================================== */

        .theme-toggle {

            position: fixed;

            top: 20px;

            right: 20px;

            width: 44px;

            height: 44px;

            border-radius: 50%;

            border: 1px solid var(--card-border);

            background: var(--card);

            color: var(--text);

            cursor: pointer;

            font-size: 18px;

            display: flex;

            align-items: center;

            justify-content: center;

            backdrop-filter: blur(10px);

            transition: .3s ease;
        }


        .theme-toggle:hover {

            background: var(--accent);

            color: #111;

            transform: scale(1.08);
        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 500px) {

            body {

                padding: 15px;
            }


            .success-card {

                padding: 35px 22px;

                border-radius: 20px;
            }


            .success-icon {

                width: 70px;

                height: 70px;

                font-size: 32px;
            }


            .success-card h1 {

                font-size: 23px;
            }


            .success-card p {

                font-size: 14px;
            }


            .theme-toggle {

                top: 15px;

                right: 15px;

                width: 40px;

                height: 40px;
            }
        }

    </style>

</head>


<body>


    <!-- THEME BUTTON -->

    <button
        type="button"
        class="theme-toggle"
        id="themeToggle"
        aria-label="Change theme"
    >
        ◐
    </button>


    <main class="success-container">


        <!-- BRAND -->

        <div class="brand">

            ZAKI <span>SUB</span>

        </div>


        <!-- SUCCESS CARD -->

        <section class="success-card">


            <!-- SUCCESS ICON -->

            <div class="success-icon">

                ✓

            </div>


            <!-- TITLE -->

            <h1>
                Password Reset Successful
            </h1>


            <!-- MESSAGE -->

            <p>
                Your password has been changed successfully.
                You can now log in to your account using your
                new password.
            </p>


            <!-- LOGIN -->

            <a
                href="/login"
                class="login-btn"
            >
                Continue to Login
            </a>


        </section>


        <!-- FOOTER -->

        <div class="footer">

            © <%= new Date().getFullYear() %> Zaki Sub.
            All rights reserved.

        </div>


    </main>


    <script>

        /* =====================================================
           THEME SYSTEM
        ===================================================== */

        const savedTheme =
            localStorage.getItem("zaki-theme") || "dark";


        document.documentElement.setAttribute(
            "data-theme",
            savedTheme
        );


        const themeToggle =
            document.getElementById("themeToggle");


        themeToggle.addEventListener(
            "click",
            function () {

                const currentTheme =
                    document.documentElement.getAttribute(
                        "data-theme"
                    ) || "dark";


                const newTheme =
                    currentTheme === "dark"
                        ? "light"
                        : "dark";


                document.documentElement.setAttribute(
                    "data-theme",
                    newTheme
                );


                localStorage.setItem(
                    "zaki-theme",
                    newTheme
                );

            }
        );

    </script>


</body>

</html>

