<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Reset Password | Zaki Sub</title>


    <style>

        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =====================================================
           DARK MODE - DEFAULT
        ===================================================== */

        :root {

            --bg: #250D0D;
            --bg-dark: #170707;

            --card: rgba(255,255,255,.08);

            --card-border: rgba(255,255,255,.15);

            --text: #ffffff;

            --muted: #d6caca;

            --input-bg: rgba(255,255,255,.08);

            --input-border: rgba(255,255,255,.18);

            --accent: #F5C451;

            --accent-dark: #D99A18;

            --danger: #EF4444;

            --shadow:
                0 20px 50px rgba(0,0,0,.40);
        }


        /* =====================================================
           LIGHT MODE
        ===================================================== */

        [data-theme="light"] {

            --bg: #F4F8F6;

            --bg-dark: #E8F1EE;

            --card: rgba(255,255,255,.90);

            --card-border: rgba(11,31,51,.10);

            --text: #10202F;

            --muted: #64748B;

            --input-bg: #F5F8F7;

            --input-border: rgba(11,31,51,.14);

            --accent: #0F766E;

            --accent-dark: #0B5F59;

            --danger: #DC2626;

            --shadow:
                0 20px 50px rgba(11,31,51,.12);
        }


        /* =====================================================
           BODY
        ===================================================== */

        body {

            min-height: 100vh;

            display: flex;

            justify-content: center;

            align-items: center;

            padding: 20px;

            background:

                radial-gradient(
                    circle at top left,
                    rgba(245,196,81,.10),
                    transparent 35%
                ),

                radial-gradient(
                    circle at bottom right,
                    rgba(15,118,110,.10),
                    transparent 35%
                ),

                var(--bg);

            color: var(--text);

            transition:
                background .3s ease,
                color .3s ease;
        }


        /* =====================================================
           THEME BUTTON
        ===================================================== */

        .theme-toggle {

            position: fixed;

            top: 20px;

            right: 20px;

            width: 44px;

            height: 44px;

            border-radius: 50%;

            border: 1px solid var(--card-border);

            background: var(--card);

            color: var(--text);

            backdrop-filter: blur(12px);

            -webkit-backdrop-filter: blur(12px);

            cursor: pointer;

            font-size: 18px;

            display: flex;

            align-items: center;

            justify-content: center;

            transition: .3s;

            z-index: 10;
        }


        .theme-toggle:hover {

            background: var(--accent);

            color: #111;

            transform: scale(1.08);
        }


        /* =====================================================
           CONTAINER
        ===================================================== */

        .container {

            width: 100%;

            max-width: 430px;
        }


        /* =====================================================
           BRAND
        ===================================================== */

        .brand {

            text-align: center;

            margin-bottom: 25px;
        }


        .brand-logo {

            font-size: 30px;

            font-weight: 800;

            letter-spacing: .5px;

            color: var(--text);

            margin-bottom: 8px;
        }


        .brand-logo span {

            color: var(--accent);
        }


        .brand-text {

            color: var(--muted);

            font-size: 14px;

            line-height: 1.5;
        }


        /* =====================================================
           CARD
        ===================================================== */

        .card {

            background: var(--card);

            backdrop-filter: blur(15px);

            -webkit-backdrop-filter: blur(15px);

            border: 1px solid var(--card-border);

            border-radius: 22px;

            padding: 32px;

            box-shadow: var(--shadow);

            transition:
                background .3s ease,
                border-color .3s ease,
                box-shadow .3s ease;
        }


        /* =====================================================
           ICON
        ===================================================== */

        .lock-icon {

            width: 62px;

            height: 62px;

            margin: 0 auto 20px;

            border-radius: 18px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 27px;

            color: #111;

            background:

                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            box-shadow:
                0 10px 25px
                rgba(245,196,81,.20);
        }


        /* =====================================================
           TITLE
        ===================================================== */

        .card h2 {

            text-align: center;

            color: var(--text);

            font-size: 24px;

            margin-bottom: 8px;
        }


        .card-description {

            text-align: center;

            color: var(--muted);

            font-size: 14px;

            line-height: 1.5;

            margin-bottom: 25px;
        }


        /* =====================================================
           FORM GROUP
        ===================================================== */

        .form-group {

            margin-bottom: 18px;
        }


        .form-group label {

            display: block;

            color: var(--text);

            font-size: 14px;

            font-weight: bold;

            margin-bottom: 7px;
        }


        /* =====================================================
           INPUT
        ===================================================== */

        .input-wrapper {

            position: relative;
        }


        .input-wrapper input {

            width: 100%;

            height: 48px;

            padding: 0 45px 0 15px;

            border-radius: 11px;

            border: 1px solid var(--input-border);

            background: var(--input-bg);

            color: var(--text);

            outline: none;

            font-size: 15px;

            transition:
                border-color .3s ease,
                background .3s ease,
                box-shadow .3s ease;
        }


        .input-wrapper input::placeholder {

            color: var(--muted);
        }


        .input-wrapper input:focus {

            border-color: var(--accent);

            box-shadow:
                0 0 0 3px
                rgba(15,118,110,.10);
        }


        /* =====================================================
           PASSWORD TOGGLE
        ===================================================== */

        .show-password {

            position: absolute;

            right: 13px;

            top: 50%;

            transform: translateY(-50%);

            border: none;

            background: transparent;

            color: var(--muted);

            cursor: pointer;

            font-size: 16px;
        }


        .show-password:hover {

            color: var(--accent);
        }


        /* =====================================================
           BUTTON
        ===================================================== */

        .btn {

            width: 100%;

            height: 49px;

            margin-top: 8px;

            border: none;

            border-radius: 12px;

            background:

                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: #ffffff;

            font-size: 15px;

            font-weight: bold;

            cursor: pointer;

            box-shadow:
                0 8px 22px
                rgba(15,118,110,.18);

            transition: .3s;
        }


        .btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 12px 28px
                rgba(15,118,110,.25);
        }


        .btn:active {

            transform: translateY(0);
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .back-login {

            text-align: center;

            margin-top: 20px;

            font-size: 14px;

            color: var(--muted);
        }


        .back-login a {

            color: var(--accent);

            font-weight: bold;

            text-decoration: none;
        }


        .back-login a:hover {

            text-decoration: underline;
        }


        .footer {

            text-align: center;

            margin-top: 25px;

            color: var(--muted);

            font-size: 12px;
        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 600px) {

            body {

                padding: 15px;
            }


            .theme-toggle {

                top: 15px;

                right: 15px;

                width: 40px;

                height: 40px;
            }


            .card {

                padding: 25px 20px;

                border-radius: 18px;
            }


            .brand-logo {

                font-size: 27px;
            }


            .lock-icon {

                width: 56px;

                height: 56px;

                font-size: 24px;
            }


            .card h2 {

                font-size: 21px;
            }
        }

    </style>

</head>


<body>


    <!-- THEME BUTTON -->

    <button
        type="button"
        class="theme-toggle"
        id="themeToggle"
        aria-label="Change theme"
    >
        🌙
    </button>



    <div class="container">


        <!-- BRAND -->

        <div class="brand">

            <div class="brand-logo">
                ZAKI <span>SUB</span>
            </div>

            <p class="brand-text">
                Secure account recovery
            </p>

        </div>



        <!-- CARD -->

        <div class="card">


            <!-- ICON -->

            <div class="lock-icon">
                🔐
            </div>


            <h2>
                Create New Password
            </h2>


            <p class="card-description">
                Create a strong new password for your
                Zaki Sub account.
            </p>



            <!-- FORM -->

            <form
                action="/reset-password/<%= token %>"
                method="POST"
            >


                <!-- NEW PASSWORD -->

                <div class="form-group">

                    <label for="password">
                        New Password
                    </label>

                    <div class="input-wrapper">

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter new password"
                            required
                        >

                        <button
                            type="button"
                            class="show-password"
                            onclick="togglePassword('password', this)"
                        >
                            👁
                        </button>

                    </div>

                </div>



                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label for="confirmPassword">
                        Confirm Password
                    </label>

                    <div class="input-wrapper">

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Confirm new password"
                            required
                        >

                        <button
                            type="button"
                            class="show-password"
                            onclick="togglePassword('confirmPassword', this)"
                        >
                            👁
                        </button>

                    </div>

                </div>



                <!-- SUBMIT -->

                <button
                    type="submit"
                    class="btn"
                >
                    Change Password
                </button>


            </form>



            <!-- BACK TO LOGIN -->

            <div class="back-login">

                Remember your password?

                <a href="/login">
                    Login
                </a>

            </div>


        </div>



        <!-- FOOTER -->

        <div class="footer">

            © <%= new Date().getFullYear() %> Zaki Sub.
            All rights reserved.

        </div>


    </div>



    <script>

        /* =====================================================
           LOAD SAVED THEME
        ===================================================== */

        const savedTheme =
            localStorage.getItem("zaki-theme") || "dark";


        document.documentElement.setAttribute(
            "data-theme",
            savedTheme
        );


        const themeToggle =
            document.getElementById("themeToggle");


        function updateThemeIcon() {

            const currentTheme =
                document.documentElement.getAttribute(
                    "data-theme"
                );

            themeToggle.textContent =
                currentTheme === "light"
                    ? "🌙"
                    : "☀️";
        }


        updateThemeIcon();


        /* =====================================================
           CHANGE THEME
        ===================================================== */

        themeToggle.addEventListener(
            "click",
            function () {

                const currentTheme =
                    document.documentElement.getAttribute(
                        "data-theme"
                    );


                const newTheme =
                    currentTheme === "dark"
                        ? "light"
                        : "dark";


                document.documentElement.setAttribute(
                    "data-theme",
                    newTheme
                );


                localStorage.setItem(
                    "zaki-theme",
                    newTheme
                );


                updateThemeIcon();

            }
        );


        /* =====================================================
           SHOW / HIDE PASSWORD
        ===================================================== */

        function togglePassword(
            inputId,
            button
        ) {

            const input =
                document.getElementById(inputId);


            if (input.type === "password") {

                input.type = "text";

                button.textContent = "🙈";

            } else {

                input.type = "password";

                button.textContent = "👁";
            }

        }

    </script>


</body>
</html>