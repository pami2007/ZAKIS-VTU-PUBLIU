
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    

    <title>Airtime Management</title>
<link rel="icon" type="image/x-icon" href="/images/zaki_logo.png">

    <style>

        /* =====================================================
           ZAKI SUB - AIRTIME ADMIN PAGE
           DARK  : BROWN + GOLD
           LIGHT : EMERALD + NAVY + GOLD
        ===================================================== */


        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        :root {

            --bg: #100909;

            --card: #1B1111;

            --card2: #241616;

            --brand: #250D0D;

            --brand-light: #3A1818;

            --accent: #F5C451;

            --accent-dark: #D99A18;

            --text: #FFFFFF;

            --muted: #B9AFAF;

            --border: rgba(255,255,255,.08);

            --success: #22C55E;

            --danger: #EF4444;

            --input: #211010;

            --shadow:
                0 12px 30px rgba(0,0,0,.25);
        }


        /* =====================================================
           LIGHT MODE
        ===================================================== */

        [data-theme="light"] {

            --bg: #F4F8F6;

            --card: #FFFFFF;

            --card2: #F0F7F5;

            --brand: #0B1F33;

            --brand-light: #163B5C;

            --accent: #0F766E;

            --accent-dark: #0B5F59;

            --text: #10202F;

            --muted: #64748B;

            --border: rgba(11,31,51,.10);

            --success: #16A34A;

            --danger: #DC2626;

            --input: #F1F5F3;

            --shadow:
                0 12px 30px rgba(11,31,51,.08);
        }


        /* =====================================================
           BODY
        ===================================================== */

        body {

            background: var(--bg);

            color: var(--text);

            min-height: 100vh;

            transition:
                background .3s ease,
                color .3s ease;
        }


        /* =====================================================
           MAIN
        ===================================================== */

        .admin-main {

            margin-left: 250px;

            padding: 30px;

            min-height: 100vh;
        }


        /* =====================================================
           PAGE HEADER
        ===================================================== */

        .page-header {

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 20px;

            margin-bottom: 25px;
        }


        .page-title h1 {

            font-size: 28px;

            margin-bottom: 6px;
        }


        .page-title p {

            color: var(--muted);

            font-size: 14px;
        }


        .add-btn {

            border: none;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: #fff;

            padding: 12px 18px;

            border-radius: 10px;

            font-weight: bold;

            cursor: pointer;

            transition: .3s;
        }


        .add-btn:hover {

            transform: translateY(-2px);

            opacity: .9;
        }


        /* =====================================================
           STATISTICS
        ===================================================== */

        .stats-grid {

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 15px;

            margin-bottom: 25px;
        }


        .stat-card {

            background: var(--card);

            border: 1px solid var(--border);

            border-radius: 15px;

            padding: 20px;

            box-shadow: var(--shadow);

            transition: .3s;
        }


        .stat-card:hover {

            transform: translateY(-3px);
        }


        .stat-label {

            color: var(--muted);

            font-size: 13px;

            margin-bottom: 10px;
        }


        .stat-value {

            font-size: 25px;

            font-weight: bold;
        }


        .stat-value.gold {

            color: var(--accent);
        }


        .stat-value.green {

            color: var(--success);
        }


        /* =====================================================
           FILTER BAR
        ===================================================== */

        .filter-bar {

            background: var(--card);

            border: 1px solid var(--border);

            border-radius: 15px;

            padding: 15px;

            display: flex;

            gap: 12px;

            flex-wrap: wrap;

            margin-bottom: 20px;
        }


        .search-box {

            flex: 1;

            min-width: 200px;
        }


        .search-box input,
        .filter-bar select {

            width: 100%;

            height: 42px;

            padding: 0 12px;

            border-radius: 9px;

            border: 1px solid var(--border);

            background: var(--input);

            color: var(--text);

            outline: none;
        }


        .filter-bar select {

            min-width: 150px;
        }


        /* =====================================================
           AIRTIME TABLE
        ===================================================== */

        .table-card {

            background: var(--card);

            border: 1px solid var(--border);

            border-radius: 17px;

            overflow: hidden;

            box-shadow: var(--shadow);

            margin-bottom: 25px;
        }


        .table-header {

            padding: 18px;

            border-bottom: 1px solid var(--border);

            display: flex;

            justify-content: space-between;

            align-items: center;
        }


        .table-header h2 {

            font-size: 18px;
        }


        .table-header span {

            color: var(--muted);

            font-size: 13px;
        }


        .table-wrapper {

            width: 100%;

            overflow-x: auto;
        }


        table {

            width: 100%;

            border-collapse: collapse;

            min-width: 800px;
        }


        th {

            text-align: left;

            padding: 14px 16px;

            color: var(--muted);

            font-size: 12px;

            text-transform: uppercase;

            border-bottom: 1px solid var(--border);
        }


        td {

            padding: 15px 16px;

            border-bottom: 1px solid var(--border);

            font-size: 14px;
        }


        tr:last-child td {

            border-bottom: none;
        }


        tr:hover {

            background: var(--card2);
        }


        /* =====================================================
           NETWORK
        ===================================================== */

        .network {

            display: flex;

            align-items: center;

            gap: 10px;

            font-weight: bold;
        }


        .network-icon {

            width: 35px;

            height: 35px;

            border-radius: 9px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: var(--brand);

            color: var(--accent);

            font-size: 12px;

            font-weight: bold;
        }


        /* =====================================================
           PRICE
        ===================================================== */

        .price {

            font-weight: bold;
        }


        .provider-price {

            color: var(--muted);
        }


        .profit {

            color: var(--success);

            font-weight: bold;
        }


        /* =====================================================
           STATUS
        ===================================================== */

        .status {

            display: inline-flex;

            padding: 5px 10px;

            border-radius: 20px;

            font-size: 11px;

            font-weight: bold;
        }


        .status.active {

            background: rgba(34,197,94,.12);

            color: var(--success);
        }


        .status.inactive {

            background: rgba(239,68,68,.12);

            color: var(--danger);
        }


        /* =====================================================
           ACTIONS
        ===================================================== */

        .actions {

            display: flex;

            gap: 7px;
        }


        .action-btn {

            border: 1px solid var(--border);

            background: var(--card2);

            color: var(--text);

            padding: 7px 10px;

            border-radius: 7px;

            cursor: pointer;

            font-size: 12px;

            transition: .2s;
        }


        .action-btn:hover {

            border-color: var(--accent);

            color: var(--accent);
        }


        .action-btn.delete:hover {

            border-color: var(--danger);

            color: var(--danger);
        }


        /* =====================================================
           ADD / UPDATE FORM
        ===================================================== */

        .form-card {

            background: var(--card);

            border: 1px solid var(--border);

            border-radius: 17px;

            padding: 22px;

            box-shadow: var(--shadow);

            margin-bottom: 25px;
        }


        .form-header {

            margin-bottom: 20px;
        }


        .form-header h2 {

            font-size: 19px;

            margin-bottom: 5px;
        }


        .form-header p {

            color: var(--muted);

            font-size: 13px;
        }


        .form-grid {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 15px;
        }


        .form-group {

            display: flex;

            flex-direction: column;

            gap: 7px;
        }


        .form-group.full {

            grid-column: 1 / -1;
        }


        .form-group label {

            font-size: 13px;

            font-weight: bold;
        }


        .form-group input,
        .form-group select {

            height: 43px;

            padding: 0 12px;

            border-radius: 9px;

            border: 1px solid var(--border);

            background: var(--input);

            color: var(--text);

            outline: none;
        }


        .form-group input:focus,
        .form-group select:focus {

            border-color: var(--accent);
        }


        .form-actions {

            display: flex;

            justify-content: flex-end;

            gap: 10px;

            margin-top: 20px;
        }


        .cancel-btn {

            padding: 11px 18px;

            border: 1px solid var(--border);

            background: var(--card2);

            color: var(--text);

            border-radius: 9px;

            cursor: pointer;
        }


        .save-btn {

            padding: 11px 20px;

            border: none;

            border-radius: 9px;

            background: var(--accent);

            color: #fff;

            font-weight: bold;

            cursor: pointer;
        }


        /* =====================================================
           MOBILE CARDS
        ===================================================== */

        .mobile-plans {

            display: none;
        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 1000px) {

            .admin-main {

                margin-left: 230px;

                padding: 20px;
            }


            .stats-grid {

                grid-template-columns:
                    repeat(2, 1fr);
            }


            .form-grid {

                grid-template-columns:
                    repeat(2, 1fr);
            }
        }


        /* =====================================================
           PHONE
        ===================================================== */

        @media (max-width: 700px) {

            .admin-main {

                margin-left: 0;

                padding:
                    80px 15px 20px;
            }


            .page-header {

                align-items: flex-start;

                flex-direction: column;
            }


            .page-title h1 {

                font-size: 23px;
            }


            .add-btn {

                width: 100%;
            }


            .stats-grid {

                grid-template-columns:
                    repeat(2, 1fr);

                gap: 10px;
            }


            .stat-card {

                padding: 15px;
            }


            .stat-value {

                font-size: 21px;
            }


            .filter-bar {

                flex-direction: column;
            }


            .search-box {

                min-width: 100%;
            }


            .form-grid {

                grid-template-columns: 1fr;
            }


            .form-actions {

                flex-direction: column;
            }


            .cancel-btn,
            .save-btn {

                width: 100%;
            }
        }


        /* =====================================================
           SMALL PHONE
        ===================================================== */

        @media (max-width: 420px) {

            .stats-grid {

                grid-template-columns: 1fr;
            }


            .stat-card {

                display: flex;

                justify-content: space-between;

                align-items: center;
            }
        }

    </style>

</head>


<body>



<%- include('./partials/sidebar') %>

<%- include('partials/alerts') %>
<main class="admin-main">


    <!-- =====================================================
         PAGE HEADER
    ===================================================== -->

    <header class="page-header">

        <div class="page-title">

            <h1>
                Airtime
            </h1>

            <p>
                Manage airtime services, pricing and profit.
            </p>

        </div>


        <button
            class="add-btn"
            onclick="showAddForm()"
        >
            + Add Airtime Plan
        </button>

    </header>


    <!-- =====================================================
         STATISTICS
    ===================================================== -->

    <section class="stats-grid">


        <div class="stat-card">

            <div class="stat-label">
                Total Airtime Plans
            </div>

            <div class="stat-value">
                <%=TA.tc%>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-label">
                Active Plans
            </div>

            <div class="stat-value green">
                <%=AA.tc%>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-label">
                Inactive Plans
            </div>

            <div class="stat-value">
                <%=Number(IA.tc)%>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-label">
                Airtime Profit
            </div>

            <div class="stat-value gold">
                ₦<%= Number(TAP.tp).toLocaleString() %>
            </div>

        </div>


    </section>


    <!-- =====================================================
         ADD / UPDATE FORM
    ===================================================== -->

    <section
        class="form-card"
        id="airtimeForm"
        style="display:none;"

        
    >

        <div class="form-header">

            <h2>
                Add Airtime Plan
            </h2>

            <p>
                Create or update an airtime service plan.
            </p>

        </div>


        <form action="/admin/airtime/add" method="post">


            <div class="form-grid">


                <!-- NETWORK -->

                <div class="form-group">

                    <label>
                        Network
                    </label>

                    <select name="network" required>

                        <option value="">
                            Select Network
                        </option>

                        <option value="MTN">
                            MTN
                        </option>

                        <option value="AIRTEL">
                            Airtel
                        </option>

                        <option value="GLO">
                            Glo
                        </option>

                        <option value="9MOBILE">
                            9mobile
                        </option>

                    </select>

                </div>


                <!-- PLAN NAME -->

                <div class="form-group">

                    <label>
                        networkID
                    </label>

                    <input
                        type="text"
                        name="networkID"
                        placeholder="Example: MTN = 1, AIRTEL = 2, GLO = 3"
                        required
                    >

                </div>


                <!-- PROVIDER PRICE -->

                <div class="form-group">

                    <label>
                    Price
                    </label>

                    <input
                        type="number"
                        name="amount"
                        placeholder="100"
                        required
                    >

                </div>


                <!-- SELLING PRICE -->

                <!--<div class="form-group">

                    <label>
                        Selling Price
                    </label>

                    <input
                        type="number"
                        name="selling_price"
                        placeholder="105"
                    >

                </div>


              

                <div class="form-group">

                    <label>
                        Profit
                    </label>

                    <input
                        type="number"
                        name="profit"
                        placeholder="5"
                    >

                </div>


               

                <div class="form-group">

                    <label>
                        Status
                    </label>

                    <select name="status">

                        <option value="ACTIVE">
                            Active
                        </option>

                        <option value="INACTIVE">
                            Inactive
                        </option>

                    </select>

                </div>


            </div>-->


            <div class="form-actions">

                <button
                    type="button"
                    class="cancel-btn"
                    onclick="hideAddForm()"
                >
                    Cancel
                </button>


                <button
                    type="submit"
                    class="save-btn"
                >
                    Save Airtime Plan
                </button>

            </div>


        </form>

    </section>


    <!-- =====================================================
         FILTER
    ===================================================== -->

    <section class="filter-bar">


        <div class="search-box">

            <input
                type="search"
                id="searchInput"
                placeholder="Search airtime plans..."
                onkeyup="searchPlans()"
            >

        </div>


        <select id="networkFilter">

            <option value="ALL">
                All Networks
            </option>

            <option value="MTN">
                MTN
            </option>

            <option value="AIRTEL">
                Airtel
            </option>

            <option value="GLO">
                Glo
            </option>

            <option value="9MOBILE">
                9mobile
            </option>

        </select>


        <select id="statusFilter">

            <option value="ALL">
                All Status
            </option>

            <option value="ACTIVE">
                Active
            </option>

            <option value="INACTIVE">
                Inactive
            </option>

        </select>


    </section>


    <!-- =====================================================
         AIRTIME PLANS
    ===================================================== -->

    <section class="table-card">


        <div class="table-header">

            <h2>
                Airtime Plans
            </h2>

            <span>
                Manage your existing plans
            </span>

        </div>


        <div class="table-wrapper">

            <table id="airtimeTable">

                <thead>

                    <tr>

                        <th>
                            Network
                        </th>

                        <th>
                            Plan
                        </th>

                        

                        <th>
                            Selling Price
                        </th>

                        <th>
                            Profit
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>                    
                    <% view.slice(0,50).forEach(item => { %>
                        <tr>

                        <td>

                            <div class="network">

                                <div class="network-icon">
                                    <%=item.id%>
                                </div>

                                 <%=item.network%>

                            </div>

                        </td>


                        <td>
                             <%=item.network%>  <%=item.type%>
                        </td>


                        <td class="price">
                             ₦<%= Number(item.amount).toLocaleString() %>.00
                        </td>


                        <td class="profit">
                            3 - 5% per txn
                        </td>


                        <td>

                            
                            <%if(item.active_status === 'active') {%>
                                    <span class="status active">
                                        <%=item.active_status%>
                                    </span>
                                    <%}else{%>
                                        <span class="status inactive">
                                        <%=item.active_status%>
                                    </span>
                            <%}%>
                        </td>


                        <td>

                            <div class="actions">

                                <a href="/admin/airtime/<%=item.id%>/edit"><button
                                    class="action-btn"
                                >
                                    Edit
                                </button></a>

                                
                                <%if(item.active_status === 'active'){%>
                                        <a href="/admin/airtime/<%=item.id%>/disable"><button
                                            class="action-btn delete"
                                            type="button"
                                        >
                                            Disable
                                        </button></a>
                                        <%}else{%>
                                            <a href="/admin/airtime/<%=item.id%>/enable"><button
                                            class="action-btn delete"
                                            type="button"
                                        >
                                            Enable
                                        </button></a>
                                <%}%>

                            </div>

                        </td>

                    </tr>
                     <%})%>
                </tbody>

            </table>

        </div>

    </section>


</main>


<script>

    /* =====================================================
       SHOW ADD FORM
    ===================================================== */

    function showAddForm() {

        document.getElementById(
            "airtimeForm"
        ).style.display = "block";

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });

    }


    /* =====================================================
       HIDE FORM
    ===================================================== */

    function hideAddForm() {

        document.getElementById(
            "airtimeForm"
        ).style.display = "none";

    }


    /* =====================================================
       EDIT PLAN
    ===================================================== */

    function editPlan(network) {

        showAddForm();

        console.log(
            "Edit airtime plan:",
            network
        );

        /*
            When converting to EJS,
            replace this with your real
            edit route.

            Example:

            /admin/airtime/edit/:id
        */

    }


    /* =====================================================
       ENABLE / DISABLE
    ===================================================== */

    function togglePlan(button) {

        const row =
            button.closest("tr");

        const status =
            row.querySelector(".status");


        if (
            status.classList.contains("active")
        ) {

            status.classList.remove("active");

            status.classList.add("inactive");

            status.textContent =
                "INACTIVE";

            button.textContent =
                "Enable";

        } else {

            status.classList.remove("inactive");

            status.classList.add("active");

            status.textContent =
                "ACTIVE";

            button.textContent =
                "Disable";
        }

    }


    /* =====================================================
       SEARCH
    ===================================================== */

    function searchPlans() {

        const input =
            document
                .getElementById("searchInput")
                .value
                .toLowerCase();


        const rows =
            document
                .querySelectorAll(
                    "#airtimeTable tbody tr"
                );


        rows.forEach(row => {

            const text =
                row.textContent.toLowerCase();


            row.style.display =
                text.includes(input)
                    ? ""
                    : "none";

        });

    }

</script>


</body>

</html>

