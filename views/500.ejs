<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>500 - Server Error</title>

    <link
        rel="icon"
        type="image/x-icon"
        href="/images/zaki_logo.png"
    >

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =========================
           DARK THEME
        ========================= */

        :root {

            --bg: #100909;
            --card: rgba(255,255,255,.07);
            --border: rgba(255,255,255,.12);

            --text: #fff;
            --muted: #c7bbbb;

            --accent: #F5C451;
            --accent-dark: #D99A18;

            --danger: #ef4444;

            --shadow:
                0 20px 60px rgba(0,0,0,.4);
        }


        /* =========================
           LIGHT THEME
        ========================= */

        [data-theme="light"] {

            --bg: #F4F8F6;

            --card: rgba(255,255,255,.9);

            --border: rgba(11,31,51,.10);

            --text: #10202F;
            --muted: #64748B;

            --accent: #0F766E;
            --accent-dark: #0B5F59;

            --shadow:
                0 20px 60px rgba(11,31,51,.10);
        }


        /* =========================
           BODY
        ========================= */

        body {

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 20px;

            color: var(--text);

            background:

                radial-gradient(
                    circle at top left,
                    rgba(245,196,81,.10),
                    transparent 30%
                ),

                radial-gradient(
                    circle at bottom right,
                    rgba(15,118,110,.10),
                    transparent 30%
                ),

                var(--bg);

            transition: .3s ease;
        }


        /* =========================
           THEME BUTTON
        ========================= */

        .theme-btn {

            position: fixed;

            top: 20px;

            right: 20px;

            width: 44px;

            height: 44px;

            border-radius: 50%;

            border: 1px solid var(--border);

            background: var(--card);

            color: var(--text);

            cursor: pointer;

            font-size: 18px;

            display: flex;

            align-items: center;

            justify-content: center;

            backdrop-filter: blur(10px);

            transition: .3s;
        }


        .theme-btn:hover {

            background: var(--accent);

            color: #111;

            transform: scale(1.08);
        }


        /* =========================
           CONTAINER
        ========================= */

        .error-container {

            width: 100%;

            max-width: 600px;

            text-align: center;
        }


        /* =========================
           LOGO
        ========================= */

        .logo {

            font-size: 26px;

            font-weight: 800;

            margin-bottom: 20px;
        }


        .logo span {

            color: var(--accent);
        }


        /* =========================
           500
        ========================= */

        .error-number {

            font-size: clamp(120px, 25vw, 190px);

            line-height: .85;

            font-weight: 900;

            letter-spacing: -10px;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            -webkit-background-clip: text;

            -webkit-text-fill-color: transparent;

            background-clip: text;

            animation: float 4s ease-in-out infinite;
        }


        @keyframes float {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }
        }


        /* =========================
           CARD
        ========================= */

        .error-card {

            margin-top: 25px;

            padding: 35px 30px;

            border-radius: 24px;

            background: var(--card);

            border: 1px solid var(--border);

            box-shadow: var(--shadow);

            backdrop-filter: blur(15px);
        }


        /* =========================
           ICON
        ========================= */

        .error-icon {

            width: 65px;

            height: 65px;

            margin: 0 auto 20px;

            border-radius: 18px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: rgba(239,68,68,.12);

            border: 1px solid rgba(239,68,68,.2);

            color: var(--danger);

            font-size: 28px;

            font-weight: bold;
        }


        /* =========================
           TITLE
        ========================= */

        .error-card h1 {

            font-size: 27px;

            margin-bottom: 12px;
        }


        /* =========================
           MESSAGE
        ========================= */

        .error-card p {

            color: var(--muted);

            font-size: 15px;

            line-height: 1.7;

            max-width: 440px;

            margin: auto;
        }


        /* =========================
           BUTTONS
        ========================= */

        .actions {

            display: flex;

            justify-content: center;

            gap: 12px;

            margin-top: 28px;
        }


        .btn {

            min-width: 170px;

            height: 48px;

            padding: 0 20px;

            border-radius: 12px;

            display: flex;

            align-items: center;

            justify-content: center;

            text-decoration: none;

            font-weight: bold;

            font-size: 14px;

            transition: .3s;
        }


        .home-btn {

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: white;

            box-shadow:
                0 8px 20px rgba(15,118,110,.18);
        }


        .home-btn:hover {

            transform: translateY(-3px);

            box-shadow:
                0 12px 28px rgba(15,118,110,.25);
        }


        .back-btn {

            border: 1px solid var(--border);

            background: var(--card);

            color: var(--text);
        }


        .back-btn:hover {

            background: var(--accent);

            color: white;

            transform: translateY(-3px);
        }


        /* =========================
           FOOTER
        ========================= */

        .footer {

            margin-top: 25px;

            color: var(--muted);

            font-size: 12px;
        }


        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 500px) {

            .error-number {

                font-size: 120px;

                letter-spacing: -6px;
            }


            .error-card {

                padding: 30px 20px;

                border-radius: 20px;
            }


            .error-card h1 {

                font-size: 23px;
            }


            .error-card p {

                font-size: 14px;
            }


            .actions {

                flex-direction: column;
            }


            .btn {

                width: 100%;
            }
        }

    </style>

</head>


<body>


    <!--<button
        type="button"
        class="theme-btn"
        id="themeBtn"
    >
        ◐
    </button>-->


    <main class="error-container">


        <div class="logo">

            ZAKI <span>SUB</span>

        </div>


        <div class="error-number">

            500

        </div>


        <section class="error-card">


            <div class="error-icon">

                !

            </div>


            <h1>
                Something Went Wrong
            </h1>


            <p>

                <%=err.message || `We ran into an unexpected problem while
                processing your request. Don't worry,
                your account is safe. Please try again
                in a moment`%>
        
            </p>


            <div class="actions">

                <a
                    href="/"
                    class="btn home-btn"
                >
                    Back to Home
                </a>


                <a
                    href="javascript:location.reload()"
                    class="btn back-btn"
                >
                    Try Again
                </a>

            </div>


        </section>


        <div class="footer">

            © <%= new Date().getFullYear() %> Zaki Sub.
            All rights reserved.

        </div>


    </main>


    <script>

        const savedTheme =
            localStorage.getItem("zaki-theme") || "dark";


        document.documentElement.setAttribute(
            "data-theme",
            savedTheme
        );


        document
            .getElementById("themeBtn")
            .addEventListener("click", function () {

                const current =
                    document.documentElement
                    .getAttribute("data-theme") || "dark";


                const newTheme =
                    current === "dark"
                        ? "light"
                        : "dark";


                document.documentElement
                    .setAttribute(
                        "data-theme",
                        newTheme
                    );


                localStorage.setItem(
                    "zaki-theme",
                    newTheme
                );

            });

    </script>

</body>

</html>