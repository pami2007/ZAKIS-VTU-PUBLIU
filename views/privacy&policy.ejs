<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Privacy Policy - Zaki Sub</title>

    <link
        rel="icon"
        type="image/x-icon"
        href="/images/zaki_logo.png"
    >

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =========================
           DARK MODE
        ========================= */

        :root {

            --bg: #100909;
            --card: #190b0b;

            --border: rgba(255,255,255,.08);

            --text: #ffffff;
            --muted: #b9aaaa;

            --accent: #F5C451;
            --accent-dark: #D99A18;
        }


        /* =========================
           LIGHT MODE
        ========================= */

        [data-theme="light"] {

            --bg: #F4F8F6;
            --card: #ffffff;

            --border: rgba(11,31,51,.10);

            --text: #10202F;
            --muted: #64748B;

            --accent: #0F766E;
            --accent-dark: #0B5F59;
        }


        body {

            background: var(--bg);

            color: var(--text);

            min-height: 100vh;

            padding: 20px;

            transition: .3s;
        }


        /* =========================
           CONTAINER
        ========================= */

        .container {

            width: 100%;

            max-width: 800px;

            margin: 40px auto;
        }


        /* =========================
           HEADER
        ========================= */

        .header {

            text-align: center;

            margin-bottom: 25px;
        }


        .logo {

            font-size: 27px;

            font-weight: 800;

            margin-bottom: 10px;
        }


        .logo span {

            color: var(--accent);
        }


        .header p {

            color: var(--muted);

            font-size: 14px;
        }


        /* =========================
           CARD
        ========================= */

        .card {

            background: var(--card);

            border: 1px solid var(--border);

            border-radius: 20px;

            padding: 30px;

            box-shadow:
                0 15px 40px rgba(0,0,0,.15);
        }


        .card h1 {

            font-size: 25px;

            margin-bottom: 8px;
        }


        .updated {

            color: var(--muted);

            font-size: 13px;

            margin-bottom: 30px;
        }


        /* =========================
           SECTIONS
        ========================= */

        .section {

            margin-bottom: 25px;
        }


        .section h2 {

            font-size: 17px;

            margin-bottom: 8px;

            color: var(--accent);
        }


        .section p {

            color: var(--muted);

            font-size: 14px;

            line-height: 1.7;
        }


        .section ul {

            padding-left: 20px;

            color: var(--muted);
        }


        .section li {

            font-size: 14px;

            line-height: 1.7;

            margin-bottom: 5px;
        }


        /* =========================
           BACK BUTTON
        ========================= */

        .back {

            display: block;

            width: 180px;

            text-align: center;

            margin: 25px auto 0;

            padding: 13px;

            border-radius: 10px;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: #fff;

            text-decoration: none;

            font-weight: bold;
        }


        .back:hover {

            opacity: .9;
        }


        /* =========================
           THEME BUTTON
        ========================= */

        .theme-btn {

            position: fixed;

            top: 20px;

            right: 20px;

            width: 42px;

            height: 42px;

            border-radius: 50%;

            border: 1px solid var(--border);

            background: var(--card);

            color: var(--text);

            cursor: pointer;

            font-size: 17px;
        }


        /* =========================
           MOBILE
        ========================= */

        @media(max-width:600px) {

            body {

                padding: 15px;
            }


            .container {

                margin: 30px auto;
            }


            .card {

                padding: 22px;
            }


            .card h1 {

                font-size: 22px;
            }


            .theme-btn {

                top: 15px;

                right: 15px;
            }

        }

    </style>

</head>


<body>


    <!-- THEME -->

    <button
        class="theme-btn"
        id="themeBtn"
        type="button"
    >
        ◐
    </button>


    <div class="container">


        <!-- HEADER -->

        <div class="header">

            <div class="logo">

                ZAKI <span>SUB</span>

            </div>

            <p>
                Privacy Policy
            </p>

        </div>


        <!-- CONTENT -->

        <div class="card">


            <h1>
                Privacy Policy
            </h1>

            <p class="updated">
                Last updated: August 2026
            </p>


            <!-- 1 -->

            <div class="section">

                <h2>
                    1. Information We Collect
                </h2>

                <p>
                    When you use Zaki Sub, we may collect
                    information such as your name, phone number,
                    email address, transaction details and
                    account information.
                </p>

            </div>


            <!-- 2 -->

            <div class="section">

                <h2>
                    2. How We Use Your Information
                </h2>

                <p>
                    We use your information to create and manage
                    your account, process transactions, provide
                    customer support, improve our services and
                    protect our platform from fraud and abuse.
                </p>

            </div>


            <!-- 3 -->

            <div class="section">

                <h2>
                    3. Transaction Information
                </h2>

                <p>
                    Transaction information may be stored to
                    provide you with transaction history,
                    receipts, support and account records.
                </p>

            </div>


            <!-- 4 -->

            <div class="section">

                <h2>
                    4. Payment Information
                </h2>

                <p>
                    Payments may be processed through third-party
                    payment providers. We do not intentionally
                    store your complete card or sensitive payment
                    credentials on our servers.
                </p>

            </div>


            <!-- 5 -->

            <div class="section">

                <h2>
                    5. Information Security
                </h2>

                <p>
                    We take reasonable measures to protect your
                    personal information against unauthorized
                    access, alteration, disclosure or destruction.
                </p>

            </div>


            <!-- 6 -->

            <div class="section">

                <h2>
                    6. Third-Party Services
                </h2>

                <p>
                    Zaki Sub may use third-party providers to
                    deliver services such as airtime, data,
                    electricity, television subscriptions and
                    payment processing. These providers may
                    process information required to complete
                    your transactions.
                </p>

            </div>


            <!-- 7 -->

            <div class="section">

                <h2>
                    7. Cookies & Local Storage
                </h2>

                <p>
                    We may use cookies, local storage and similar
                    technologies to maintain sessions, remember
                    preferences and improve your experience.
                </p>

            </div>


            <!-- 8 -->

            <div class="section">

                <h2>
                    8. Your Information
                </h2>

                <p>
                    You may contact us regarding your personal
                    information, account details or privacy
                    concerns through our available support
                    channels.
                </p>

            </div>


            <!-- 9 -->

            <div class="section">

                <h2>
                    9. Changes to This Policy
                </h2>

                <p>
                    We may update this Privacy Policy from time
                    to time. Any changes will be reflected on
                    this page.
                </p>

            </div>


            <!-- 10 -->

            <div class="section">

                <h2>
                    10. Contact Us
                </h2>

                <p>
                    If you have questions about this Privacy
                    Policy or how your information is handled,
                    please contact Zaki Sub support.
                </p>

            </div>


            <a
                href="/"
                class="back"
            >
                Back to Home
            </a>


        </div>

    </div>


    <script>

        /* =========================
           LOAD THEME
        ========================= */

        const savedTheme =
            localStorage.getItem("zaki-theme") || "dark";


        document.documentElement.setAttribute(
            "data-theme",
            savedTheme
        );


        /* =========================
           CHANGE THEME
        ========================= */

        document
            .getElementById("themeBtn")
            .addEventListener("click", function () {

                const current =
                    document.documentElement
                    .getAttribute("data-theme") || "dark";


                const newTheme =
                    current === "dark"
                        ? "light"
                        : "dark";


                document.documentElement.setAttribute(
                    "data-theme",
                    newTheme
                );


                localStorage.setItem(
                    "zaki-theme",
                    newTheme
                );

            });

    </script>


</body>

</html>