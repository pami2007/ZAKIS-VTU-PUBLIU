<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Check Your Email</title>

    <style>

        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =====================================================
           DARK MODE
        ===================================================== */

        :root {

            --bg: #250D0D;

            --bg-secondary: #170707;

            --card: rgba(255,255,255,.08);

            --border: rgba(255,255,255,.15);

            --text: #ffffff;

            --muted: #d6caca;

            --accent: #F5C451;

            --accent-dark: #D99A18;

            --button-text: #1a1205;

            --shadow:
                0 20px 45px rgba(0,0,0,.4);
        }


        /* =====================================================
           LIGHT MODE
        ===================================================== */

        [data-theme="light"] {

            --bg: #F4F8F6;

            --bg-secondary: #E8F1EE;

            --card: rgba(255,255,255,.85);

            --border: rgba(11,31,51,.12);

            --text: #10202F;

            --muted: #64748B;

            --accent: #0F766E;

            --accent-dark: #0B5F59;

            --button-text: #ffffff;

            --shadow:
                0 20px 45px rgba(11,31,51,.12);
        }


        /* =====================================================
           BODY
        ===================================================== */

        body {

            min-height: 100vh;

            display: flex;

            justify-content: center;

            align-items: center;

            padding: 20px;

            background:

                radial-gradient(
                    circle at top left,
                    rgba(245,196,81,.10),
                    transparent 35%
                ),

                radial-gradient(
                    circle at bottom right,
                    rgba(15,118,110,.10),
                    transparent 35%
                ),

                var(--bg);

            color: var(--text);

            transition:
                background .3s ease,
                color .3s ease;
        }


        /* =====================================================
           CONTAINER
        ===================================================== */

        .container {

            width: 100%;

            max-width: 430px;

            text-align: center;
        }


        /* =====================================================
           LOGO
        ===================================================== */

        .logo {

            margin-bottom: 25px;
        }


        .logo h1 {

            font-size: 31px;

            font-weight: 800;

            letter-spacing: .5px;

            color: var(--text);
        }


        .logo h1 span {

            color: var(--accent);
        }


        .logo p {

            margin-top: 7px;

            color: var(--muted);

            font-size: 14px;
        }


        /* =====================================================
           CARD
        ===================================================== */

        .card {

            padding: 38px 30px;

            border-radius: 22px;

            background:
                linear-gradient(
                    145deg,
                    var(--card),
                    rgba(255,255,255,.03)
                );

            border: 1px solid var(--border);

            backdrop-filter: blur(15px);

            -webkit-backdrop-filter: blur(15px);

            box-shadow: var(--shadow);

            transition:
                background .3s ease,
                border-color .3s ease,
                box-shadow .3s ease;
        }


        /* =====================================================
           EMAIL ICON
        ===================================================== */

        .email-icon {

            width: 75px;

            height: 75px;

            margin: 0 auto 22px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: var(--button-text);

            font-size: 32px;

            box-shadow:
                0 10px 25px
                rgba(245,196,81,.20);
        }


        /* =====================================================
           TITLE
        ===================================================== */

        .card h2 {

            font-size: 25px;

            margin-bottom: 13px;

            color: var(--text);
        }


        /* =====================================================
           DESCRIPTION
        ===================================================== */

        .message {

            color: var(--muted);

            font-size: 15px;

            line-height: 1.7;

            max-width: 350px;

            margin: auto;
        }


        /* =====================================================
           INFO BOX
        ===================================================== */

        .info-box {

            margin-top: 22px;

            padding: 13px 15px;

            border-radius: 12px;

            background: rgba(245,196,81,.08);

            border: 1px solid rgba(245,196,81,.18);

            color: var(--muted);

            font-size: 13px;

            line-height: 1.5;
        }


        /* =====================================================
           BUTTON
        ===================================================== */

        .btn {

            display: block;

            width: 100%;

            margin-top: 25px;

            padding: 14px 20px;

            border-radius: 30px;

            background:
                linear-gradient(
                    135deg,
                    var(--accent),
                    var(--accent-dark)
                );

            color: var(--button-text);

            text-decoration: none;

            font-size: 15px;

            font-weight: bold;

            transition:
                transform .3s ease,
                box-shadow .3s ease;
        }


        .btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 10px 25px
                rgba(15,118,110,.20);
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .footer {

            margin-top: 25px;

            color: var(--muted);

            font-size: 13px;

            line-height: 1.6;
        }


        .footer a {

            color: var(--accent);

            text-decoration: none;

            font-weight: bold;
        }


        .footer a:hover {

            text-decoration: underline;
        }


        /* =====================================================
           THEME BUTTON
        ===================================================== */

        .theme-toggle {

            position: fixed;

            top: 20px;

            right: 20px;

            width: 44px;

            height: 44px;

            border-radius: 50%;

            border: 1px solid var(--border);

            background: var(--card);

            backdrop-filter: blur(10px);

            -webkit-backdrop-filter: blur(10px);

            color: var(--text);

            font-size: 18px;

            cursor: pointer;

            transition: .3s ease;
        }


        .theme-toggle:hover {

            transform: scale(1.08);

            background: var(--accent);

            color: var(--button-text);
        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 600px) {

            body {

                padding: 15px;
            }


            .card {

                padding: 32px 20px;

                border-radius: 19px;
            }


            .logo h1 {

                font-size: 27px;
            }


            .card h2 {

                font-size: 22px;
            }


            .email-icon {

                width: 68px;

                height: 68px;

                font-size: 28px;
            }


            .theme-toggle {

                top: 15px;

                right: 15px;

                width: 40px;

                height: 40px;

                font-size: 16px;
            }
        }


        /* =====================================================
           SMALL PHONES
        ===================================================== */

        @media (max-width: 380px) {

            .card {

                padding: 28px 17px;
            }


            .message {

                font-size: 14px;
            }
        }

    </style>

</head>


<body>


    <!-- THEME BUTTON -->

    <button
        type="button"
        class="theme-toggle"
        id="themeToggle"
        aria-label="Change theme"
    >
        ◐
    </button>


    <div class="container">


        <!-- LOGO -->

        <div class="logo">

            <h1>
                ZAKI <span>SUB</span>
            </h1>

            <p>
                Secure account recovery
            </p>

        </div>


        <!-- CARD -->

        <div class="card">


            <!-- EMAIL ICON -->

            <div class="email-icon">

                ✉

            </div>


            <!-- TITLE -->

            <h2>
                Check Your Email
            </h2>


            <!-- MESSAGE -->

            <p class="message">

                If an account exists with that email,
                a password reset link has been sent.

            </p>


            <!-- INFO -->

            <div class="info-box">

                Check your inbox and your spam or junk
                folder if you don't see the email.

            </div>


            <!-- BACK TO LOGIN -->

            <a
                href="/login"
                class="btn"
            >
                Back to Login
            </a>


        </div>


        <!-- FOOTER -->

        <div class="footer">

            Didn't request a password reset?

            <br>

            You can safely ignore this message.

        </div>


    </div>


    <script>

        /* =====================================================
           THEME
        ===================================================== */

        const savedTheme =
            localStorage.getItem("zaki-theme") || "dark";


        document.documentElement.setAttribute(
            "data-theme",
            savedTheme
        );


        const themeToggle =
            document.getElementById("themeToggle");


        themeToggle.addEventListener(
            "click",
            function () {

                const currentTheme =
                    document.documentElement.getAttribute(
                        "data-theme"
                    );


                const newTheme =
                    currentTheme === "dark"
                        ? "light"
                        : "dark";


                document.documentElement.setAttribute(
                    "data-theme",
                    newTheme
                );


                localStorage.setItem(
                    "zaki-theme",
                    newTheme
                );

            }
        );

    </script>


</body>
</html>