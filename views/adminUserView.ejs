<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>User Details</title>

    <style>

        /* ====================================
           THEME
        ==================================== */

        :root{

            --bg:#100909;

            --card:#1b1111;

            --card2:#241616;

            --brand:#250d0d;

            --brand-light:#3a1818;

            --accent:#f5c451;

            --text:#ffffff;

            --muted:#b9afaf;

            --border:rgba(255,255,255,.08);

            --success:#22c55e;

            --danger:#ef4444;

            --shadow:
                0 10px 30px rgba(0,0,0,.30);

        }


        [data-theme="light"]{

            --bg:#f4f8f6;

            --card:#ffffff;

            --card2:#f0f7f5;

            --brand:#0b1f33;

            --brand-light:#163b5c;

            --accent:#0f766e;

            --text:#10202f;

            --muted:#64748b;

            --border:rgba(0,0,0,.08);

            --shadow:
                0 10px 30px rgba(0,0,0,.08);

        }


        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial,Helvetica,sans-serif;
        }


        body{

            background:var(--bg);

            color:var(--text);

            min-height:100vh;
        }


        /* MAIN */

        .admin-main{

            margin-left:250px;

            padding:25px;
        }


        /* CARD */

        .card{

            background:var(--card);

            border:1px solid var(--border);

            border-radius:18px;

            padding:25px;

            margin-bottom:25px;

            box-shadow:var(--shadow);
        }


        .card h2{

            margin-bottom:20px;

            color:var(--accent);
        }


        /* USER GRID */

        .user-grid{

            display:grid;

            grid-template-columns:
                repeat(3,1fr);

            gap:15px;
        }


        .info-box{

            background:var(--card2);

            border:1px solid var(--border);

            border-radius:12px;

            padding:15px;
        }


        .info-box label{

            display:block;

            font-size:12px;

            color:var(--muted);

            margin-bottom:7px;
        }


        .info-box p{

            font-size:15px;

            font-weight:bold;

            word-break:break-word;
        }


        /* FORM */

        .form-grid{

            display:grid;

            grid-template-columns:
                repeat(2,1fr);

            gap:18px;
        }


        .form-group{

            display:flex;

            flex-direction:column;
        }


        .form-group label{

            margin-bottom:8px;

            color:var(--muted);

            font-size:13px;
        }


        input,
        select{

            height:48px;

            padding:0 15px;

            border-radius:10px;

            border:1px solid var(--border);

            background:var(--card2);

            color:var(--text);

            outline:none;
        }


        input:focus,
        select:focus{

            border-color:var(--accent);
        }


        .btn{

            margin-top:20px;

            width:100%;

            height:50px;

            border:none;

            border-radius:12px;

            background:linear-gradient(
                135deg,
                var(--accent),
                #d99a18
            );

            color:white;

            font-weight:bold;

            cursor:pointer;
        }


        .status-active{

            color:var(--success);
        }


        /* MOBILE */

        @media(max-width:900px){

            .user-grid{

                grid-template-columns:
                    repeat(2,1fr);
            }

            .form-grid{

                grid-template-columns:1fr;
            }

        }


        @media(max-width:700px){

            .admin-main{

                margin-left:0;

                padding:80px 15px 20px;
            }

            .user-grid{

                grid-template-columns:1fr;
            }

        }

    </style>

</head>


<body data-theme="dark">



    <%- include('./partials/sidebar') %>

    <main class="admin-main">


        <!-- ===================================
             USER DETAILS
        ==================================== -->
<div ><a href="/admin/users"style="background-color: #ddd; text-decoration: none; color: black; max-width: 100px; padding: 10px; border: 1px solid gold; height: 10px;">back</a></div>

        <section class="card">
            <h2>
                User Details
            </h2>


            <div class="user-grid">


                <div class="info-box">
                    <label>ID</label>
                    <p><%=item.id%></p>
                </div>


                <div class="info-box">
                    <label>First Name</label>
                    <p><%=item.fname%></p>
                </div>


                <div class="info-box">
                    <label>Last Name</label>
                    <p><%=item.lname%></p>
                </div>


                <div class="info-box">
                    <label>Email</label>
                    <p>
                        <%=item.email%>
                    </p>
                </div>


                <div class="info-box">
                    <label>Phone</label>
                    <p><%=item.phone%></p>
                </div>


                <div class="info-box">
                    <label>Role</label>
                    <p><%=item.roles%></p>
                </div>


                <div class="info-box">
                    <label>Wallet Balance</label>
                    <p>₦<%= Number(item.bal).toLocaleString() %>.00</p>
                </div>


                <div class="info-box">
                    <label>Cashback</label>
                    <p>₦<%= Number(item.cashBack).toLocaleString() %>.00</p>
                </div>


                <div class="info-box">
                    <label>Total Cashback</label>
                    <p>₦<%= Number(item.total_cb).toLocaleString() %>.00</p>
                </div>


                <div class="info-box">
                    <label>Status</label>
                    <p class="status-active">
                        <%=item.acc_status%>
                    </p>
                </div>


                <div class="info-box">
                    <label>Date Joined</label>
                    <p>
                        <%= new Date(item.date_Joined).toLocaleString() %>
                    </p>
                </div>


                <div class="info-box">
                    <label>Last Active</label>
                    <p>
                        <%= new Date(item.last_active).toLocaleString() %>
                    </p>
                </div>

            </div>

        </section>



        <!-- ===================================
             UPDATE FORM
        ==================================== -->

        <section class="card">

            <h2>
                Update User
            </h2>


            <form action="/admin/user/<%=item.id%>/edits" method="post">

                <div class="form-grid">


                    <div class="form-group">

                        <label>
                            First Name
                        </label>

                        <input
                            type="text"
                            name="fname"
                            value="<%=item.fname%>"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Last Name
                        </label>

                        <input
                            type="text"
                            name="lname"
                            value="<%=item.lname%>"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Email
                        </label>

                        <input
                            type="email"
                            name="email"
                            value="<%=item.email%>"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Phone
                        </label>

                        <input
                            type="number"
                            name="phone"
                            value="<%=item.phone%>"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Wallet Balance
                        </label>

                        <input
                            type="number" required
                            name="bal"
                            value="<%=item.bal%>"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Cashback
                        </label>

                        <input
                            type="number"
                            name="cashBack"
                            value="<%=item.cashBack%>"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Role
                        </label>

                        <select name="roles" required>

                            <option selected>
                               <%=item.roles%>
                            </option>
                            
                            <option>
                                user
                            </option>

                            <option>
                                admin
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label>
                            Account Status
                        </label>

                        <select name="acc_status" required>

                            <option selected>
                                <%=item.acc_status%>
                            </option>
                            <option>
                                active
                            </option>
                            <option>
                                suspend
                            </option>
                        </select>

                    </div>

                </div>


                <button class="btn">

                    Update User

                </button>

            </form>

        </section>

    </main>

</body>

</html>