<!DOCTYPE html>
<html lang="en">

<head>
<link rel="icon" type="image/x-icon" href="/images/zaki_logo.png">
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Profit | Zaki Sub Admin</title>

    <!-- Your reusable sidebar/theme CSS -->
    <link
        rel="stylesheet"
        href="/css/admin-sidebar.css"
    >

    <style>

        /* =====================================================
           PROFIT PAGE
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        body {
            background: var(--admin-bg);
            color: var(--admin-text);
        }


        /* =====================================================
           PAGE HEADER
        ===================================================== */

        .profit-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }


        .profit-header h1 {
            font-size: 28px;
            margin-bottom: 6px;
        }


        .profit-header p {
            color: var(--admin-muted);
            font-size: 14px;
        }


        /* =====================================================
           FILTER
        ===================================================== */

        .profit-filter {
            display: flex;
            gap: 10px;
        }


        .profit-filter select {
            padding: 10px 13px;
            border-radius: 9px;
            border: 1px solid var(--admin-border);
            background: var(--admin-sidebar);
            color: var(--admin-text);
            outline: none;
            cursor: pointer;
        }


        /* =====================================================
           PROFIT CARDS
        ===================================================== */

        .profit-cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 25px;
        }


        .profit-card {
            background: var(--admin-sidebar);
            border: 1px solid var(--admin-border);
            border-radius: 16px;
            padding: 20px;
            transition: .3s ease;
        }


        .profit-card:hover {
            transform: translateY(-3px);
            border-color: var(--admin-accent);
        }


        .profit-card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }


        .profit-card-title {
            color: var(--admin-muted);
            font-size: 13px;
        }


        .profit-card-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--admin-hover);
            color: var(--admin-accent);
            font-weight: bold;
        }


        .profit-card h2 {
            font-size: 25px;
            margin-bottom: 7px;
        }


        .profit-card small {
            color: var(--admin-muted);
            font-size: 12px;
        }


        .profit-up {
            color: #22c55e;
        }


        /* =====================================================
           MAIN PROFIT GRID
        ===================================================== */

        .profit-content {
            display: grid;
            grid-template-columns: 1fr 1.5fr;
            gap: 20px;
            margin-bottom: 25px;
        }


        /* =====================================================
           BREAKDOWN
        ===================================================== */

        .profit-box {
            background: var(--admin-sidebar);
            border: 1px solid var(--admin-border);
            border-radius: 16px;
            overflow: hidden;
        }


        .profit-box-header {
            padding: 18px;
            border-bottom: 1px solid var(--admin-border);
        }


        .profit-box-header h3 {
            font-size: 17px;
        }


        .profit-box-header p {
            color: var(--admin-muted);
            font-size: 12px;
            margin-top: 5px;
        }


        .profit-breakdown {
            padding: 18px;
        }


        .breakdown-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px dashed var(--admin-border);
        }


        .breakdown-item:last-child {
            border-bottom: none;
        }


        .breakdown-left {
            display: flex;
            align-items: center;
            gap: 11px;
        }


        .breakdown-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--admin-hover);
            color: var(--admin-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }


        .breakdown-name {
            font-size: 14px;
            font-weight: bold;
        }


        .breakdown-description {
            display: block;
            color: var(--admin-muted);
            font-size: 11px;
            margin-top: 3px;
        }


        .breakdown-amount {
            font-weight: bold;
            color: var(--admin-accent);
        }


        /* =====================================================
           PROFIT SUMMARY
        ===================================================== */

        .summary {
            padding: 18px;
        }


        .summary-main {
            padding: 20px;
            border-radius: 14px;

            background:
                linear-gradient(
                    135deg,
                    var(--admin-brand),
                    var(--admin-brand-light)
                );

            margin-bottom: 18px;
        }


        .summary-main span {
            color: rgba(255,255,255,.70);
            font-size: 13px;
        }


        .summary-main h2 {
            color: #fff;
            margin-top: 8px;
            font-size: 30px;
        }


        .summary-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }


        .summary-item {
            padding: 15px;
            background: var(--admin-hover);
            border-radius: 11px;
        }


        .summary-item span {
            display: block;
            color: var(--admin-muted);
            font-size: 12px;
            margin-bottom: 6px;
        }


        .summary-item strong {
            font-size: 17px;
        }


        /* =====================================================
           RECENT PROFIT
        ===================================================== */

        .recent-profit {
            background: var(--admin-sidebar);
            border: 1px solid var(--admin-border);
            border-radius: 16px;
            overflow: hidden;
        }


        .recent-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px;
            border-bottom: 1px solid var(--admin-border);
        }


        .recent-header h3 {
            font-size: 17px;
        }


        .recent-header span {
            color: var(--admin-muted);
            font-size: 12px;
        }


        /* =====================================================
           TABLE
        ===================================================== */

        .profit-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }


        .profit-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 650px;
        }


        .profit-table th {
            text-align: left;
            padding: 14px 18px;
            color: var(--admin-muted);
            font-size: 11px;
            font-weight: bold;
            border-bottom: 1px solid var(--admin-border);
        }


        .profit-table td {
            padding: 15px 18px;
            border-bottom: 1px solid var(--admin-border);
            font-size: 13px;
        }


        .profit-table tr:last-child td {
            border-bottom: none;
        }


        .profit-table tr:hover {
            background: var(--admin-hover);
        }


        .transaction-user {
            font-weight: bold;
        }


        .transaction-type {
            color: var(--admin-muted);
            font-size: 11px;
            margin-top: 3px;
        }


        .profit-value {
            color: #22c55e;
            font-weight: bold;
        }


        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: bold;
        }


        .status-success {
            color: #22c55e;
            background: rgba(34,197,94,.10);
        }


        .status-pending {
            color: #f59e0b;
            background: rgba(245,158,11,.10);
        }


        .status-failed {
            color: #ef4444;
            background: rgba(239,68,68,.10);
        }


        .transaction-date {
            color: var(--admin-muted);
            font-size: 11px;
        }


        /* =====================================================
           EMPTY STATE
        ===================================================== */

        .empty-profit {
            text-align: center;
            padding: 35px 20px;
            color: var(--admin-muted);
        }


        .empty-profit h3 {
            color: var(--admin-text);
            margin-bottom: 7px;
        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 1000px) {

            .profit-cards {
                grid-template-columns: repeat(2, 1fr);
            }


            .profit-content {
                grid-template-columns: 1fr;
            }
        }


        /* =====================================================
           PHONE
        ===================================================== */

        @media (max-width: 600px) {

            .profit-header {
                flex-direction: column;
                align-items: flex-start;
            }


            .profit-header h1 {
                font-size: 24px;
            }


            .profit-filter {
                width: 100%;
            }


            .profit-filter select {
                width: 100%;
            }


            .profit-cards {
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
            }


            .profit-card {
                padding: 15px;
            }


            .profit-card h2 {
                font-size: 19px;
            }


            .profit-card-icon {
                width: 32px;
                height: 32px;
            }


            .summary-grid {
                grid-template-columns: 1fr;
            }


            .profit-box,
            .recent-profit {
                border-radius: 13px;
            }
        }


        /* =====================================================
           VERY SMALL PHONE
        ===================================================== */

        @media (max-width: 380px) {

            .profit-cards {
                grid-template-columns: 1fr;
            }


            .profit-card h2 {
                font-size: 22px;
            }
        }

    </style>

</head>


<body>


    

         <%- include('./partials/sidebar') %>

   
    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="admin-main">


        <!-- PAGE HEADER -->

        <div class="profit-header">

            <div>

                <h1>
                    Profit
                </h1>

                <p>
                    Monitor your business earnings and profit.
                </p>

            </div>


            <div class="profit-filter">

                <select>

                    <option>
                        Today
                    </option>

                    <option>
                        This Week
                    </option>

                    <option>
                        This Month
                    </option>

                    <option>
                        This Year
                    </option>

                    <option>
                        All Time
                    </option>

                </select>

            </div>

        </div>


        <!-- =================================================
             PROFIT CARDS
        ================================================== -->

        <section class="profit-cards">


            <!-- TOTAL PROFIT -->

            <div class="profit-card">

                <div class="profit-card-top">

                    <span class="profit-card-title">
                        Total Profit
                    </span>

                    <div class="profit-card-icon">
                        ₦
                    </div>

                </div>

                <h2>
                    ₦<%= Number(total_profitss.tp).toLocaleString() %>
                </h2>

                <small class="profit-up">
                    Overall earnings
                </small>

            </div>


            <!-- TODAY -->

            <div class="profit-card">

                <div class="profit-card-top">

                    <span class="profit-card-title">
                        Today's Profit
                    </span>

                    <div class="profit-card-icon">
                        ₦
                    </div>

                </div>

                <h2>
                    ₦<%= Number(todayprofits.tp).toLocaleString() %>
                </h2>

                <small class="profit-up">
                    Today
                </small>

            </div>


            <!-- MONTH -->

            <div class="profit-card">

                <div class="profit-card-top">

                    <span class="profit-card-title">
                        Monthly Profit
                    </span>

                    <div class="profit-card-icon">
                        ₦
                    </div>

                </div>

                <h2>
                   ₦<%= Number(mon.tp).toLocaleString() %>
                </h2>

                <small class="profit-up">
                    This month
                </small>

            </div>


            <!-- DEPOSIT FEES -->

            <div class="profit-card">

                <div class="profit-card-top">

                    <span class="profit-card-title">
                        Deposit Fees
                    </span>

                    <div class="profit-card-icon">
                        ₦
                    </div>

                </div>

                <h2>
                    1.5% fee per deposit
                </h2>

                <small>
                    Deposit-related earnings
                </small>

            </div>

        </section>


        <!-- =================================================
             PROFIT CONTENT
        ================================================== -->

        <section class="profit-content">


            <!-- PROFIT BREAKDOWN -->

            <div class="profit-box">

                <div class="profit-box-header">

                    <h3>
                        Profit Breakdown
                    </h3>

                    <p>
                        Earnings by service
                    </p>

                </div>


                <div class="profit-breakdown">


                    <!-- AIRTIME -->

                    <div class="breakdown-item">

                        <div class="breakdown-left">

                            <div class="breakdown-icon">
                                A
                            </div>

                            <div>

                                <div class="breakdown-name">
                                    Airtime
                                </div>

                                <span class="breakdown-description">
                                    Airtime transactions
                                </span>

                            </div>

                        </div>


                        <span class="breakdown-amount">
                            ₦<%= Number(AP.tp).toLocaleString() %>
                        </span>

                    </div>


                    <div class="breakdown-item">

                        <div class="breakdown-left">

                            <div class="breakdown-icon">
                                A
                            </div>

                            <div>

                                <div class="breakdown-name">
                                    Eletric Purchase
                                </div>

                                <span class="breakdown-description">
                                    Electricity transactions
                                </span>

                            </div>

                        </div>


                        <span class="breakdown-amount">
                            ₦<%= Number(eleprofit.tp).toLocaleString() %>
                        </span>

                    </div>



                    <!-- DATA -->

                    <div class="breakdown-item">

                        <div class="breakdown-left">

                            <div class="breakdown-icon">
                                D
                            </div>

                            <div>

                                <div class="breakdown-name">
                                    Data
                                </div>

                                <span class="breakdown-description">
                                    Data transactions
                                </span>

                            </div>

                        </div>


                        <span class="breakdown-amount">
                            ₦<%= Number(DP.tp).toLocaleString() %>
                        </span>

                    </div>

                    


                    <!-- DEPOSIT -->

                    <div class="breakdown-item">

                        <div class="breakdown-left">

                            <div class="breakdown-icon">
                                ₦
                            </div>

                            <div>

                                <div class="breakdown-name">
                                    Deposits
                                </div>

                                <span class="breakdown-description">
                                    Deposit fees
                                </span>

                            </div>

                        </div>
                        


                        <span class="breakdown-amount">
                            ₦<%= Number(DEP.tp).toLocaleString() %>
                        </span>

                    </div>


                    <!-- OTHER -->

                    <div class="breakdown-item">

                        <div class="breakdown-left">

                            <div class="breakdown-icon">
                                +
                            </div>

                            <div>

                                <div class="breakdown-name">
                                    TOTAL
                                </div>

                                <span class="breakdown-description">
                                    Total earning
                                </span>

                            </div>

                        </div>


                        <span class="breakdown-amount">
                            ₦<%= Number(AP.tp)+ Number(DP.tp) + Number(DEP.tp) + Number(eleprofit.tp)%>
                            
                        </span>

                    </div>

                </div>

            </div>


            <!-- PROFIT SUMMARY -->

            <div class="profit-box">

                <div class="profit-box-header">

                    <h3>
                        Profit Summary
                    </h3>

                    <p>
                        Current business performance
                    </p>

                </div>


                <div class="summary">


                    <div class="summary-main">

                        <span>
                            Net Profit
                        </span>

                        <h2>
                            ₦<%= Number(total_profitss.tp).toLocaleString() %>
                        </h2>

                    </div>


                    <div class="summary-grid">


                        <div class="summary-item">

                            <span>
                                Service Revenue
                            </span>

                            <strong>
                                ₦0.00
                            </strong>

                        </div>


                        <div class="summary-item">

                            <span>
                                Provider Cost
                            </span>

                            <strong>
                                ₦0.00
                            </strong>

                        </div>


                        <div class="summary-item">

                            <span>
                                User Cashback
                            </span>

                            <strong>
                                 ₦<%= Number(CB.tp).toLocaleString() %>
                            </strong>

                        </div>


                        <div class="summary-item">

                            <span>
                                Deposit Fees
                            </span>

                            <strong>
                                ₦<%= Number(fee.DF).toLocaleString() %>
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </section>


