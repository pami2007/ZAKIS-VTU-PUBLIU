<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="icon" type="image/x-icon" href="/images/zaki_logo.png">

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Admin Dashboard</title>

    <!-- YOUR SIDEBAR CSS -->

    <link
        rel="stylesheet"
        href="/css/admin-sidebar.css"
    >


    <style>

        /* =====================================================
           DASHBOARD LANDING PAGE
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        body {
            background: var(--admin-bg);
            color: var(--admin-text);

            transition:
                background .3s ease,
                color .3s ease;
        }


        /* =====================================================
           MAIN
        ===================================================== */

        .dashboard-home {

            width: 100%;

            max-width: 1400px;

            margin: auto;

            padding: 25px;
        }


        /* =====================================================
           WELCOME
        ===================================================== */

        .welcome-section {

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 20px;

            margin-bottom: 25px;
        }


        .welcome-text h1 {

            font-size: 28px;

            margin-bottom: 6px;

            color: var(--admin-text);
        }


        .welcome-text p {

            color: var(--admin-muted);

            font-size: 14px;
        }


        .welcome-badge {

            background: var(--admin-hover);

            border: 1px solid var(--admin-border);

            color: var(--admin-accent);

            padding: 10px 15px;

            border-radius: 10px;

            font-size: 13px;

            font-weight: bold;
        }


        /* =====================================================
           STATISTICS
        ===================================================== */

        .stats-grid {

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 15px;

            margin-bottom: 25px;
        }


        .stat-card {

            background: var(--admin-sidebar);

            border: 1px solid var(--admin-border);

            border-radius: 16px;

            padding: 20px;

            box-shadow:
                0 8px 25px rgba(0,0,0,.08);

            transition:
                transform .25s ease,
                background .3s ease,
                border-color .3s ease;
        }


        .stat-card:hover {

            transform: translateY(-3px);

            border-color: var(--admin-accent);
        }


        .stat-top {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 15px;
        }


        .stat-title {

            color: var(--admin-muted);

            font-size: 13px;
        }


        .stat-icon {

            width: 38px;

            height: 38px;

            border-radius: 10px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: var(--admin-hover);

            color: var(--admin-accent);

            font-size: 18px;

            font-weight: bold;
        }


        .stat-card h2 {

            font-size: 25px;

            color: var(--admin-text);

            margin-bottom: 6px;
        }


        .stat-card small {

            color: var(--admin-muted);

            font-size: 11px;
        }


        /* =====================================================
           QUICK ACTIONS
        ===================================================== */

        .section-title {

            font-size: 18px;

            color: var(--admin-text);

            margin-bottom: 15px;
        }


        .quick-actions {

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 15px;

            margin-bottom: 25px;
        }


        .quick-action {

            text-decoration: none;

            background: var(--admin-sidebar);

            border: 1px solid var(--admin-border);

            border-radius: 14px;

            padding: 17px;

            display: flex;

            align-items: center;

            gap: 12px;

            color: var(--admin-text);

            transition: .25s ease;
        }


        .quick-action:hover {

            transform: translateY(-3px);

            border-color: var(--admin-accent);

            background: var(--admin-hover);
        }


        .quick-action-icon {

            width: 42px;

            height: 42px;

            border-radius: 11px;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    var(--admin-accent),
                    var(--admin-accent-dark)
                );

            color: #111;

            font-weight: bold;

            font-size: 18px;
        }


        .quick-action span {

            font-size: 13px;

            font-weight: bold;
        }


        /* =====================================================
           BOTTOM GRID
        ===================================================== */

        .dashboard-bottom {

            display: grid;

            grid-template-columns: 2fr 1fr;

            gap: 20px;

            align-items: start;
        }


        /* =====================================================
           RECENT TRANSACTIONS
        ===================================================== */

        .dashboard-card {

            background: var(--admin-sidebar);

            border: 1px solid var(--admin-border);

            border-radius: 16px;

            overflow: hidden;

            box-shadow:
                0 8px 25px rgba(0,0,0,.07);
        }


        .dashboard-card-header {

            padding: 18px;

            border-bottom:
                1px solid var(--admin-border);

            display: flex;

            align-items: center;

            justify-content: space-between;
        }


        .dashboard-card-header h3 {

            font-size: 16px;

            color: var(--admin-text);
        }


        .dashboard-card-header a {

            color: var(--admin-accent);

            text-decoration: none;

            font-size: 12px;
        }


        .transactions-list {

            padding: 8px 15px;
        }


        .transaction {

            display: flex;

            align-items: center;

            gap: 12px;

            padding: 13px 3px;

            border-bottom:
                1px solid var(--admin-border);
        }


        .transaction:last-child {

            border-bottom: none;
        }


        .transaction-icon {

            width: 40px;

            height: 40px;

            border-radius: 50%;

            background: var(--admin-hover);

            color: var(--admin-accent);

            display: flex;

            align-items: center;

            justify-content: center;

            font-weight: bold;

            flex-shrink: 0;
        }


        .transaction-info {

            flex: 1;

            min-width: 0;
        }


        .transaction-info h4 {

            color: var(--admin-text);

            font-size: 13px;

            margin-bottom: 4px;
        }


        .transaction-info span {

            color: var(--admin-muted);

            font-size: 11px;
        }


        .transaction-right {

            text-align: right;
        }


        .transaction-amount {

            display: block;

            color: var(--admin-text);

            font-size: 13px;

            font-weight: bold;

            margin-bottom: 5px;
        }


        .transaction-status {

            display: inline-block;

            padding: 4px 8px;

            border-radius: 20px;

            font-size: 9px;

            font-weight: bold;
        }


        .successful {

            background: rgba(34,197,94,.12);

            color: #22c55e;
        }


        .pending {

            background: rgba(245,158,11,.12);

            color: #f59e0b;
        }


        .failed {

            background: rgba(239,68,68,.12);

            color: #ef4444;
        }


        /* =====================================================
           SYSTEM SUMMARY
        ===================================================== */

        .summary-list {

            padding: 10px 18px;
        }


        .summary-item {

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 15px 0;

            border-bottom:
                1px solid var(--admin-border);
        }


        .summary-item:last-child {

            border-bottom: none;
        }


        .summary-item span {

            color: var(--admin-muted);

            font-size: 13px;
        }


        .summary-item strong {

            color: var(--admin-text);

            font-size: 14px;
        }


        .summary-item strong.green {

            color: #22c55e;
        }


        .summary-item strong.gold {

            color: var(--admin-accent);
        }


        /* =====================================================
           TABLET
        ===================================================== */

        @media (max-width: 1000px) {

            .stats-grid {

                grid-template-columns:
                    repeat(2, 1fr);
            }


            .quick-actions {

                grid-template-columns:
                    repeat(2, 1fr);
            }


            .dashboard-bottom {

                grid-template-columns: 1fr;
            }
        }


        /* =====================================================
           PHONE
        ===================================================== */

        @media (max-width: 600px) {

            .dashboard-home {

                padding: 18px 15px;
            }


            .welcome-section {

                align-items: flex-start;

                flex-direction: column;

                margin-bottom: 20px;
            }


            .welcome-text h1 {

                font-size: 23px;
            }


            .stats-grid {

                grid-template-columns:
                    repeat(2, 1fr);

                gap: 10px;
            }


            .stat-card {

                padding: 15px;

                border-radius: 13px;
            }


            .stat-card h2 {

                font-size: 20px;
            }


            .stat-title {

                font-size: 11px;
            }


            .stat-icon {

                width: 33px;

                height: 33px;

                font-size: 15px;
            }


            .quick-actions {

                grid-template-columns:
                    repeat(2, 1fr);

                gap: 10px;
            }


            .quick-action {

                padding: 13px;

                border-radius: 12px;
            }


            .quick-action-icon {

                width: 36px;

                height: 36px;

                font-size: 15px;
            }


            .quick-action span {

                font-size: 11px;
            }


            .dashboard-bottom {

                gap: 15px;
            }


            .transaction {

                padding: 12px 2px;
            }


            .transaction-info h4 {

                font-size: 12px;
            }


            .transaction-amount {

                font-size: 11px;
            }
        }


        /* =====================================================
           VERY SMALL PHONE
        ===================================================== */

        @media (max-width: 380px) {

            .stats-grid {

                grid-template-columns: 1fr 1fr;
            }


            .stat-card {

                padding: 12px;
            }


            .stat-card h2 {

                font-size: 18px;
            }


            .quick-action {

                gap: 8px;

                padding: 11px;
            }


            .quick-action-icon {

                width: 32px;

                height: 32px;
            }
        }

    </style>

</head>


<body>


    

         <%- include('./partials/sidebar') %>
         <%- include('partials/alerts') %>



    <main class="admin-main">

        <div class="dashboard-home">


            <!-- =================================================
                 WELCOME
            ================================================== -->

            <section class="welcome-section">

                <div class="welcome-text">

                    <h1>
                        Welcome back, Admin 👋
                    </h1>

                    <p>
                        Here's what's happening with Zaki Sub today.
                    </p>

                </div>


                <div class="welcome-badge">

                    Admin Dashboard

                </div>

            </section>



            <!-- =================================================
                 STATISTICS
            ================================================== -->

            <section class="stats-grid">


                <!-- USERS -->

                <div class="stat-card">

                    <div class="stat-top">

                        <span class="stat-title">
                            Total Users
                        </span>

                        <div class="stat-icon">
                            👤
                        </div>

                    </div>

                    <h2>
                        <%=display.TU%>
                    </h2>

                    <small>
                        Registered users
                    </small>

                </div>


                <!-- TRANSACTIONS -->

                <div class="stat-card">

                    <div class="stat-top">

                        <span class="stat-title">
                            Transactions
                        </span>

                        <div class="stat-icon">
                            ↔
                        </div>

                    </div>

                    <h2>
                       <%=total_t.total_txn%>
                    </h2>

                    <small>
                        Total transactions
                    </small>

                </div>


                <!-- DEPOSITS -->

                <div class="stat-card">

                    <div class="stat-top">

                        <span class="stat-title">
                            Total Available Deposits
                        </span>

                        <div class="stat-icon">
                            ₦
                        </div>

                    </div>

                    <h2>
                        
                        ₦<%= Number(total_deposits.totalDeposit).toLocaleString() %>.00
                    </h2>

                    <small>
                        Wallet funding
                    </small>

                </div>


                <!-- PROFIT -->

                <div class="stat-card">

                    <div class="stat-top">

                        <span class="stat-title">
                            Total Profit
                        </span>

                        <div class="stat-icon">
                            ₦
                        </div>

                    </div>

                    <h2>
                        ₦<%= Number(total_profitss.tp).toLocaleString() %>.00
                    </h2>

                    <small>
                        Overall profit
                    </small>

                </div>


            </section>



            <!-- =================================================
                 QUICK ACTIONS
            ================================================== -->

            <h3 class="section-title">
                Quick Actions
            </h3>


            <section class="quick-actions">


                <a
                    href="/admin/users"
                    class="quick-action"
                >

                    <div class="quick-action-icon">
                        +
                    </div>

                    <span>
                        Manage Users
                    </span>

                </a>


                <a
                    href="/admin/transactions"
                    class="quick-action"
                >

                    <div class="quick-action-icon">
                        ↔
                    </div>

                    <span>
                        Transactions
                    </span>

                </a>


                <a
                    href="/admin/airtime"
                    class="quick-action"
                >

                    <div class="quick-action-icon">
                        ☎
                    </div>

                    <span>
                        Airtime
                    </span>

                </a>


                <a
                    href="/admin/data"
                    class="quick-action"
                >

                    <div class="quick-action-icon">
                        ▥
                    </div>

                    <span>
                        Data
                    </span>

                </a>


            </section>



            <!-- =================================================
                 BOTTOM SECTION
            ================================================== -->

            <section class="dashboard-bottom">


                <!-- =============================================
                     RECENT TRANSACTIONS
                ============================================== -->

                <div class="dashboard-card">


                    <div class="dashboard-card-header">

                        <h3>
                            Recent Transactions
                        </h3>

                        <a href="/admin/transactions">
                            View All
                        </a>

                    </div>


                    <div class="transactions-list">



    <% recent_txn.slice(0,10).forEach(item => { %>

                        <!-- TRANSACTION -->

                        <div class="transaction">

                            <div class="transaction-icon">
                                A
                            </div>


                            <div class="transaction-info">

                                <h4>
                                   <%=item.description%>
                                </h4>

                                <span>
                                    Userid <%=item.userId%> • <%= new Date(item.dates).toLocaleString() %>
                                </span>

                            </div>


                            <div class="transaction-right">

                                <span class="transaction-amount">
                                    ₦<%= Number(item.amount).toLocaleString() %>.00
                                </span>
                                <%if(item.status ==='SUCCESSFUL'){%>
                                <span class="transaction-status successful">                   
                                    <%=item.status%>
                                </span> 

                                   <%}else if(item.status==='FAILED'){%>
                                   <span class="transaction-status failed">
                                    <%=item.status%>
                                  </span> 

                                   <%}else{%>
                                  <span class="transaction-status pending">
                                    <%=item.status%>
                                   </span> 
                                <%}%>
                                
                            </div>

                        </div>
                        <% }) %>


                    </div>

                </div>



                <!-- =============================================
                     SYSTEM SUMMARY
                ============================================== -->

                <div class="dashboard-card">


                    <div class="dashboard-card-header">

                        <h3>
                            System Summary
                        </h3>

                    </div>


                    <div class="summary-list">


                        <div class="summary-item">

                            <span>
                                Successful
                            </span>

                            <strong class="green">
                                <%=Number(success.ss)%>
                            </strong>

                        </div>


                        <div class="summary-item">

                            <span>
                                Pending
                            </span>

                            <strong>
                                <%=Number(pending.ps)%>
                            </strong>

                        </div>


                        <div class="summary-item">

                            <span>
                                Failed
                            </span>

                            <strong style="color: red;">
                                <%=Number(fail.fs)%>
                            </strong>

                        </div>


                        <div class="summary-item">

                            <span>
                                Active Users
                            </span>

                            <strong class="green">
                                <%=Number(act.active)%>
                            </strong>

                        </div>


                        <div class="summary-item">

                            <span>
                                Today's Profit
                            </span>

                            <strong class="gold">
                            ₦<%= Number(todayprofits.tp).toLocaleString() %>
                            </strong>

                        </div>


                    </div>

                </div>


            </section>


        </div>

    </main>



    <!-- YOUR SIDEBAR JS -->

    <script src="/js/admin-sidebar.js"></script>


</body>

</html>