   <div class="receipt">

    <%if(item.description === 'Wallet Funding'){%>
        <div class="header">
        <h2>ZAKI SUB</h2>
        <p>Transaction Receipt</p>
    </div>

    <div class="amount">
        <h1>₦<%= Number(item.amount).toLocaleString() %>.00</h1>
        <span><%= item.ser_type %></span>
    </div>

    <div class="details">

        <div class="row">
            <div class="label">Transaction ID</div>
            <div class="value"><%= item.id %></div>
        </div>

        <div class="row">
            <div class="label">Reference</div>
            <div class="value"><%= item.ref_id %></div>
        </div>

        <div class="row">
            <div class="label">Payment reference</div>
            <div class="value"><%= item.payment_reference %></div>
        </div>

        <div class="row">
            <div class="label">Transaction reference</div>
            <div class="value"><%= item.transactionReference %></div>
        </div>

        <div class="row">
            <div class="label">Amount</div>
            <div class="value">₦<%= Number(item.amount).toLocaleString() %>.00</div>
            
        </div>

        <div class="row">
            <div class="label">Description</div>
            <div class="value"><%= item.description %></div>
        </div>

        <div class="row">
            <div class="label">Date</div>
            <div class="value">
                <%= new Date(item.dates).toLocaleString() %>
            </div>
        </div>

    </div>

    <div class="status">

        <% if(item.status === "SUCCESSFUL"){ %>

            <span class="badge success">
                ✔ Successful
            </span>

        <% }else if(item.status === "FAILED"){ %>

            <span class="badge failed">
                ✖ Failed
            </span>

        <% }else{ %>

            <span class="badge pending">
                ⏳ Pending
            </span>

        <% } %>
    </div>
    <div class="footer">
        Thank you for choosing ZAKI SUB.
    </div>
