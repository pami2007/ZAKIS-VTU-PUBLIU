<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
<link rel="icon" type="image/x-icon" href="/images/zaki_logo.png">
    <title>Transactions | Admin</title>

    <style>
        

        .transaction-page {
            max-width: 1600px;
            margin: auto;
        }


        /* ================= HEADER ================= */

        .transaction-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 25px;
        }

        .transaction-header h1 {
            font-size: 28px;
            color: var(--admin-text);
            margin-bottom: 7px;
        }

        .transaction-header p {
            color: var(--admin-muted);
            font-size: 14px;
        }


        /* ================= SUMMARY ================= */

        .transaction-summary {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 22px;
        }

        .transaction-card {
            background: var(--admin-sidebar);
            border: 1px solid var(--admin-border);
            border-radius: 16px;
            padding: 20px;
            transition: .3s ease;
        }

        .transaction-card:hover {
            transform: translateY(-3px);
            border-color: var(--admin-accent);
        }

        .transaction-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .transaction-card-title {
            color: var(--admin-muted);
            font-size: 13px;
        }

        .transaction-card-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--admin-hover);
            color: var(--admin-accent);
            font-size: 18px;
        }

        .transaction-card h2 {
            color: var(--admin-text);
            font-size: 24px;
        }

        .transaction-card small {
            display: block;
            margin-top: 7px;
            color: var(--admin-muted);
            font-size: 11px;
        }

        .transaction-card small.success {
            color: #22c55e;
        }

        .transaction-card small.failed {
            color: #ef4444;
        }

        .transaction-card small.pending {
            color: #f59e0b;
        }


        /* ================= TOOLBAR ================= */

        .transaction-container {
            background: var(--admin-sidebar);
            border: 1px solid var(--admin-border);
            border-radius: 18px;
            overflow: hidden;
        }

        .transaction-toolbar {
            padding: 18px;
            border-bottom: 1px solid var(--admin-border);
        }

        .transaction-toolbar-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .transaction-toolbar-top h2 {
            color: var(--admin-text);
            font-size: 18px;
        }

        .transaction-export {
            border: 1px solid var(--admin-border);
            background: var(--admin-hover);
            color: var(--admin-text);
            padding: 9px 14px;
            border-radius: 9px;
            cursor: pointer;
            font-size: 13px;
        }

        .transaction-export:hover {
            color: var(--admin-accent);
            border-color: var(--admin-accent);
        }


        /* ================= SEARCH ================= */

        .transaction-filters {
            display: grid;
            grid-template-columns: 2fr repeat(4, 1fr);
            gap: 10px;
        }

        .transaction-search,
        .transaction-select,
        .transaction-date {
            width: 100%;
            height: 42px;
            border-radius: 9px;
            border: 1px solid var(--admin-border);
            background: var(--admin-bg);
            color: var(--admin-text);
            outline: none;
            padding: 0 12px;
            font-size: 13px;
        }

        .transaction-search::placeholder {
            color: var(--admin-muted);
        }

        .transaction-search:focus,
        .transaction-select:focus,
        .transaction-date:focus {
            border-color: var(--admin-accent);
        }

        .transaction-select option {
            background: var(--admin-sidebar);
            color: var(--admin-text);
        }


        /* ================= TABLE ================= */

        .transaction-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .transaction-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 950px;
        }

        .transaction-table th {
            text-align: left;
            padding: 14px 16px;
            color: var(--admin-muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .5px;
            background: var(--admin-sidebar-2);
            border-bottom: 1px solid var(--admin-border);
            white-space: nowrap;
        }

        .transaction-table td {
            padding: 15px 16px;
            color: var(--admin-text);
            font-size: 13px;
            border-bottom: 1px solid var(--admin-border);
            white-space: nowrap;
        }

        .transaction-table tbody tr {
            transition: .2s ease;
        }

        .transaction-table tbody tr:hover {
            background: var(--admin-hover);
        }


        /* ================= USER ================= */

        .transaction-user {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .transaction-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(
                135deg,
                var(--admin-accent),
                var(--admin-accent-dark)
            );
            color: #111;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 12px;
        }

        .transaction-user-info strong {
            display: block;
            color: var(--admin-text);
            font-size: 13px;
        }

        .transaction-user-info span {
            display: block;
            color: var(--admin-muted);
            font-size: 10px;
            margin-top: 3px;
        }


        /* ================= REFERENCE ================= */

        .transaction-reference {
            color: var(--admin-muted);
            font-family: monospace;
            font-size: 12px;
        }


        /* ================= TYPE ================= */

        .transaction-type {
            display: inline-flex;
            padding: 5px 9px;
            border-radius: 7px;
            background: var(--admin-hover);
            color: var(--admin-text);
            font-size: 11px;
        }


        /* ================= AMOUNT ================= */

        .transaction-amount {
            font-weight: bold;
            color: var(--admin-text);
        }


        /* ================= STATUS ================= */

        .transaction-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: bold;
        }

        .transaction-status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .transaction-status.success {
            color: #22c55e;
            background: rgba(34,197,94,.10);
        }

        .transaction-status.success::before {
            background: #22c55e;
        }

        .transaction-status.failed {
            color: #ef4444;
            background: rgba(239,68,68,.10);
        }

        .transaction-status.failed::before {
            background: #ef4444;
        }

        .transaction-status.pending {
            color: #f59e0b;
            background: rgba(245,158,11,.10);
        }

        .transaction-status.pending::before {
            background: #f59e0b;
        }

        .transaction-status.reversed {
            color: #8b5cf6;
            background: rgba(139,92,246,.10);
        }

        .transaction-status.reversed::before {
            background: #8b5cf6;
        }


        /* ================= ACTION ================= */

        .transaction-view-btn {
            border: 1px solid var(--admin-border);
            background: transparent;
            color: var(--admin-accent);
            padding: 7px 10px;
            border-radius: 7px;
            cursor: pointer;
            font-size: 11px;
        }

        .transaction-view-btn:hover {
            background: var(--admin-hover);
        }


        /* ================= PAGINATION ================= */

        .transaction-pagination {
            padding: 15px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .transaction-pagination-info {
            color: var(--admin-muted);
            font-size: 12px;
        }

        .transaction-pagination-buttons {
            display: flex;
            gap: 6px;
        }

        .transaction-page-btn {
            min-width: 34px;
            height: 34px;
            border-radius: 7px;
            border: 1px solid var(--admin-border);
            background: var(--admin-hover);
            color: var(--admin-text);
            cursor: pointer;
        }

        .transaction-page-btn.active {
            background: var(--admin-accent);
            color: #111;
            border-color: var(--admin-accent);
        }

        .transaction-page-btn:hover {
            border-color: var(--admin-accent);
        }


        /* ================= MODAL ================= */

        .transaction-modal {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.60);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 2000;
            backdrop-filter: blur(3px);
        }

        .transaction-modal.open {
            display: flex;
        }

        .transaction-modal-box {
            width: 100%;
            max-width: 550px;
            max-height: 90vh;
            overflow-y: auto;
            background: var(--admin-sidebar);
            border: 1px solid var(--admin-border);
            border-radius: 18px;
            box-shadow: 0 20px 60px rgba(0,0,0,.35);
        }

        .transaction-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px;
            border-bottom: 1px solid var(--admin-border);
        }

        .transaction-modal-header h3 {
            color: var(--admin-text);
            font-size: 17px;
        }

        .transaction-modal-close {
            border: none;
            background: transparent;
            color: var(--admin-muted);
            font-size: 25px;
            cursor: pointer;
        }

        .transaction-modal-close:hover {
            color: var(--admin-accent);
        }

        .transaction-modal-body {
            padding: 18px;
        }

        .transaction-detail-amount {
            text-align: center;
            padding: 20px;
            background: var(--admin-hover);
            border-radius: 12px;
            margin-bottom: 18px;
        }

        .transaction-detail-amount span {
            display: block;
            color: var(--admin-muted);
            font-size: 12px;
            margin-bottom: 6px;
        }

        .transaction-detail-amount strong {
            font-size: 28px;
            color: var(--admin-text);
        }

        .transaction-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1px;
            background: var(--admin-border);
            border: 1px solid var(--admin-border);
            border-radius: 10px;
            overflow: hidden;
        }

        .transaction-detail {
            padding: 13px;
            background: var(--admin-sidebar);
        }

        .transaction-detail span {
            display: block;
            color: var(--admin-muted);
            font-size: 10px;
            margin-bottom: 5px;
        }

        .transaction-detail strong {
            color: var(--admin-text);
            font-size: 12px;
            word-break: break-word;
        }


        /* ================= RESPONSIVE ================= */

        @media (max-width: 1100px) {

            .transaction-summary {
                grid-template-columns: repeat(2, 1fr);
            }

            .transaction-filters {
                grid-template-columns: repeat(2, 1fr);
            }

            .transaction-search {
                grid-column: span 2;
            }
        }


        @media (max-width: 700px) {

            .transaction-header {
                flex-direction: column;
            }

            .transaction-header h1 {
                font-size: 24px;
            }

            .transaction-summary {
                grid-template-columns: 1fr 1fr;
            }

            .transaction-card {
                padding: 15px;
            }

            .transaction-card h2 {
                font-size: 19px;
            }

            .transaction-toolbar {
                padding: 14px;
            }

            .transaction-toolbar-top {
                align-items: flex-start;
            }

            .transaction-filters {
                grid-template-columns: 1fr;
            }

            .transaction-search {
                grid-column: span 1;
            }

            .transaction-pagination {
                flex-direction: column;
                align-items: flex-start;
            }
        }


        @media (max-width: 430px) {

            .transaction-summary {
                grid-template-columns: 1fr;
            }

            .transaction-card {
                padding: 17px;
            }

            .transaction-toolbar-top {
                flex-direction: column;
            }

            .transaction-export {
                width: 100%;
            }

            .transaction-details {
                grid-template-columns: 1fr;
            }

            .transaction-pagination-buttons {
                width: 100%;
                overflow-x: auto;
            }
        }
    </style>
</head>


<body>


    

         <%- include('./partials/sidebar') %>

    
   


    <!-- =================================================
         MAIN
    ================================================== -->

    <main class="admin-main">

        <section class="transaction-page">


            <!-- HEADER -->

            <div class="transaction-header">

                <div>

                    <h1>
                        Transactions
                    </h1>

                    <p>
                        Monitor, search and manage all platform transactions.
                    </p>

                </div>

            </div>


            <!-- =================================================
                 SUMMARY CARDS
            ================================================== -->

            <div class="transaction-summary">


                <!-- TOTAL -->

                <div class="transaction-card">

                    <div class="transaction-card-top">

                        <span class="transaction-card-title">
                            Total Transactions
                        </span>

                        <div class="transaction-card-icon">
                            ↔
                        </div>

                    </div>

                    <h2>
                        <%=displaytxn.total_txn%>
                    </h2>

                    <small>
                        All recorded transactions
                    </small>

                </div>


                <!-- SUCCESSFUL -->

                <div class="transaction-card">

                    <div class="transaction-card-top">

                        <span class="transaction-card-title">
                            Successful
                        </span>

                        <div class="transaction-card-icon">
                            ✓
                        </div>

                    </div>

                    <h2>
                        <%=displaytxnsuccess.total_success%>
                    </h2>

                    <small class="success">
                        95.5% success rate
                    </small>

                </div>


                <!-- PENDING -->

                <div class="transaction-card">

                    <div class="transaction-card-top">

                        <span class="transaction-card-title">
                            Pending
                        </span>

                        <div class="transaction-card-icon">
                            ⏳
                        </div>

                    </div>

                    <h2>
                        <%=displaytxnpending.total_pending%>
                    </h2>

                    <small class="pending">
                        Awaiting completion
                    </small>

                </div>


                <!-- FAILED -->

                <div class="transaction-card">

                    <div class="transaction-card-top">

                        <span class="transaction-card-title">
                            Failed
                        </span>

                        <div class="transaction-card-icon">
                            !
                        </div>

                    </div>

                    <h2>
                        <%=displaytxnfail.total_fail%>
                    </h2>

                    <small class="failed">
                        Requires attention
                    </small>

                </div>

            </div>


            <!-- =================================================
                 TRANSACTION TABLE
            ================================================== -->

            <div class="transaction-container">


                <!-- TOOLBAR -->

                <div class="transaction-toolbar">

                    <div class="transaction-toolbar-top">

                        <h2>
                            All Transactions
                        </h2>

                        <button
                            type="button"
                            class="transaction-export"
                            onclick="exportTransactions()"
                        >
                            Export
                        </button>

                    </div>


                    <!-- FILTERS -->

                    <div class="transaction-filters">


                        <!-- SEARCH -->

                        <input
                            type="search"
                            id="transactionSearch"
                            class="transaction-search"
                            placeholder="Search reference, user, phone..."
                        >


                        <!-- STATUS -->

                        <select
                            id="transactionStatus"
                            class="transaction-select"
                        >

                            <option value="">
                                All Status
                            </option>

                            <option value="success">
                                Successful
                            </option>

                            <option value="pending">
                                Pending
                            </option>

                            <option value="failed">
                                Failed
                            </option>

                            <option value="reversed">
                                Reversed
                            </option>

                        </select>


                        <!-- TYPE -->

                        <select
                            id="transactionType"
                            class="transaction-select"
                        >

                            <option value="">
                                All Types
                            </option>

                            <option value="airtime">
                                Airtime
                            </option>

                            <option value="data">
                                Data
                            </option>

                            <option value="deposit">
                                Deposit
                            </option>

                            <option value="wallet">
                                Wallet
                            </option>

                        </select>


                        <!-- NETWORK -->

                        <select
                            id="transactionNetwork"
                            class="transaction-select"
                        >

                            <option value="">
                                All Networks
                            </option>

                            <option value="mtn">
                                MTN
                            </option>

                            <option value="airtel">
                                Airtel
                            </option>

                            <option value="glo">
                                Glo
                            </option>

                            <option value="9mobile">
                                9mobile
                            </option>

                        </select>


                        <!-- DATE -->

                        <input
                            type="date"
                            id="transactionDate"
                            class="transaction-date"
                        >

                    </div>

                </div>


                <!-- TABLE -->

                <div class="transaction-table-wrapper">

                    <table class="transaction-table">

                        <thead>

                            <tr>

                                <th>
                                    Transaction
                                </th>

                                <th>
                                    User Id
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Amount
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody id="transactionTableBody">
                             <% record.slice(0,200).forEach(item => { %>
                                <tr
                                
                            >

                                <td>

                                    <span class="transaction-reference">
                                        <%=item.ref_id%>
                                    </span>

                                </td>


                                <td>

                                    <div class="transaction-user">

                                        <div class="transaction-avatar">
                                            <%=item.userId%>
                                        </div>

                                        <div class="transaction-user-info">

                                            <strong>
                                               user
                                            </strong>

                                            <span>
                                                <%=item.phone%>
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <span class="transaction-type">
                                        <%=item.ser_type%>
                                    </span>

                                </td>


                                <td>

                                    <span class="transaction-amount">
                                        ₦<%= Number(item.amount).toLocaleString() %>
                                    </span>

                                </td>


                                <td>

                                 <%if(item.status ==='SUCCESSFUL'){%>
                                <span class="transaction-status success">                   
                                    <%=item.status%>
                                </span> 

                                   <%}else if(item.status==='FAILED'){%>
                                   <span class="transaction-status failed">
                                    <%=item.status%>
                                  </span> 

                                   <%}else{%>
                                  <span class="transaction-status pending">
                                    <%=item.status%>
                                   </span> 
                                <%}%>
                                </td>

                                </span>

                                <td>
                                     <%= new Date(item.dates).toLocaleString() %>
                                </td>


                                <td>

                                    <button
                                        class="transaction-view-btn"
                                        onclick="openTransactionModal(
                                            '<%=item.ref_id%>',
                                            'Ibrahim',
                                            '<%=item.phone%>',
                                            '<%=item.ser_type%>',
                                            '₦<%= Number(item.amount).toLocaleString() %>',
                                            '<%=item.status%>',
                                            '<%= new Date(item.dates).toDateString() %>'
                                        )"
                                    >
                                        View
                                    </button>
                                    <a href="/admin/<%=item.id%>/receipt"><button class="transaction-view-btn">
                                        receipt
                                    </button></a>

                                </td>

                            </tr>


                            <%})%>
                        </tbody>

                    </table>

                </div>


                <!-- PAGINATION -->

                <div class="transaction-pagination">

                    <div class="transaction-pagination-info">
                        Showing 1–4 of 12,480 transactions
                    </div>


                    <div class="transaction-pagination-buttons">

                        <button class="transaction-page-btn">
                            ‹
                        </button>

                        <button class="transaction-page-btn active">
                            1
                        </button>

                        <button class="transaction-page-btn">
                            2
                        </button>

                        <button class="transaction-page-btn">
                            3
                        </button>

                        <button class="transaction-page-btn">
                            4
                        </button>

                        <button class="transaction-page-btn">
                            5
                        </button>

                        <button class="transaction-page-btn">
                            ›
                        </button>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- =================================================
         TRANSACTION DETAILS MODAL
    ================================================== -->

    <div
        class="transaction-modal"
        id="transactionModal"
    >

        <div class="transaction-modal-box">


            <div class="transaction-modal-header">

                <h3>
                    Transaction Details
                </h3>

                <button
                    class="transaction-modal-close"
                    onclick="closeTransactionModal()"
                >
                    ×
                </button>

            </div>


            <div class="transaction-modal-body">


                <div class="transaction-detail-amount">

                    <span>
                        Transaction Amount
                    </span>

                    <strong id="modalAmount">
                        ₦0
                    </strong>

                </div>


                <div class="transaction-details">


                    <div class="transaction-detail">

                        <span>
                            Reference
                        </span>

                        <strong id="modalReference">
                            -
                        </strong>

                    </div>


                    <div class="transaction-detail">

                        <span>
                            Status
                        </span>

                        <strong id="modalStatus">
                            -
                        </strong>

                    </div>


                    <div class="transaction-detail">

                        <span>
                            User
                        </span>

                        <strong id="modalUser">
                            -
                        </strong>

                    </div>


                    <div class="transaction-detail">

                        <span>
                            Phone
                        </span>

                        <strong id="modalPhone">
                            -
                        </strong>

                    </div>


                    <div class="transaction-detail">

                        <span>
                            Type
                        </span>

                        <strong id="modalType">
                            -
                        </strong>

                    </div>


                    <div class="transaction-detail">

                        <span>
                            Date
                        </span>

                        <strong id="modalDate">
                            -
                        </strong>

                    </div>


                </div>

            </div>

        </div>

    </div>


    <script>

        /* =====================================================
           SEARCH + FILTER
        ===================================================== */
/* =====================================================
   SEARCH + FILTER
===================================================== */

const searchInput =
    document.getElementById("transactionSearch");

const statusFilter =
    document.getElementById("transactionStatus");

const typeFilter =
    document.getElementById("transactionType");

const networkFilter =
    document.getElementById("transactionNetwork");

const dateFilter =
    document.getElementById("transactionDate");


function filterTransactions() {

    const search =
        searchInput.value.toLowerCase().trim();

    const status =
        statusFilter.value.toLowerCase();

    const type =
        typeFilter.value.toLowerCase();

    const network =
        networkFilter.value.toLowerCase();

    const date =
        dateFilter.value;


    const rows =
        document.querySelectorAll(
            "#transactionTableBody tr"
        );


    rows.forEach(function(row) {

        /*
            Search EVERYTHING displayed
            inside the transaction row.

            This means you can search:
            - Phone number
            - Transaction reference
            - User ID
            - Amount
            - Transaction type
            - Status
            - Date
        */

        const rowText =
            row.textContent
                .toLowerCase()
                .trim();


        /*
            SEARCH
        */

        const searchMatch =
            !search ||
            rowText.includes(search);


        /*
            STATUS
        */

        const rowStatus =
            row
                .querySelector(".transaction-status")
                ?.textContent
                .toLowerCase()
                .trim() || "";

        const statusMatch =
            !status ||
            rowStatus.includes(status);


        /*
            TYPE
        */

        const rowType =
            row
                .querySelector(".transaction-type")
                ?.textContent
                .toLowerCase()
                .trim() || "";

        const typeMatch =
            !type ||
            rowType.includes(type);


        /*
            NETWORK

            Your current transaction table does not
            display a separate network column.

            Therefore, only apply this filter if
            network information exists inside the row.
        */

        const networkMatch =
            !network ||
            rowText.includes(network);


        /*
            DATE
        */

        let dateMatch = true;

        if (date) {

            const rowDate =
                row
                    .querySelector("td:nth-last-child(2)")
                    ?.textContent
                    .toLowerCase()
                    .trim() || "";

            /*
                Convert selected YYYY-MM-DD
                into a searchable date.
            */

            const selectedDate =
                new Date(date + "T00:00:00");

            if (!isNaN(selectedDate.getTime())) {

                const formattedDate =
                    selectedDate.toDateString()
                        .toLowerCase();

                dateMatch =
                    rowDate.includes(formattedDate);

            }

        }


        /*
            SHOW / HIDE ROW
        */

        row.style.display =
            searchMatch &&
            statusMatch &&
            typeMatch &&
            networkMatch &&
            dateMatch
                ? ""
                : "none";

    });

}


/*
    LIVE SEARCH
*/

if (searchInput) {

    searchInput.addEventListener(
        "input",
        filterTransactions
    );

}


/*
    STATUS FILTER
*/

if (statusFilter) {

    statusFilter.addEventListener(
        "change",
        filterTransactions
    );

}


/*
    TYPE FILTER
*/

if (typeFilter) {

    typeFilter.addEventListener(
        "change",
        filterTransactions
    );

}


/*
    NETWORK FILTER
*/

if (networkFilter) {

    networkFilter.addEventListener(
        "change",
        filterTransactions
    );

}


/*
    DATE FILTER
*/

if (dateFilter) {

    dateFilter.addEventListener(
        "change",
        filterTransactions
    );

}


        /* =====================================================
           EXPORT PLACEHOLDER
           Backend can later generate real CSV.
        ===================================================== */

        function exportTransactions() {

            alert(
                "Connect this button to your transaction export route."
            );

        }

    </script>

</body>

