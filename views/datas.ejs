                    method="post"
                >

                    <div class="card-top">
                        
                        <div class="network">
                                    <%if(item.network === 'MTN'){%>
                                    <span>
                                        <img src="/images/mtn.png">
                                        <%= item.network %>
                                    </span>
                                    <%}else if(item.network === 'AIRTEL') {%>
                                        <span>
                                            <img src="/images/airtel.png">
                                            <%= item.network %>
                                        </span>
                                    <%}else if(item.network === 'GLO'){%>
                                        <span>
