                        </button>

                    </div>

                </form>

            </div>

        <% }) %>

    </div>


    <!-- =========================================
         PURCHASE LOADER
    ========================================== -->

    <div id="loader">

        <div class="spinner"></div>

        <p>
            Processing...
        </p>

    </div>

</div>


<script src="/js/disable.js" ></script>

<%- include('footer') %>
</body>
</html>